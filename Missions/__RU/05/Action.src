Export function Action;
var i;
begin
Video(true);

PlaceSeeing(80, 102, 3, -26);
RemoveSeeing(80, 102, 3);

PlaceSeeing(57, 63, 3, -26);
RemoveSeeing(57, 63, 3);

CenterNowOnXY(57, 63);

wait(0$1);

CenterOnXY(47, 49);
     
wait(0$1.3);

CenterOnXY(62, 35);

wait(0$2);

PlaceSeeing(75, 16, 3, -16);
PlaceSeeing(39, 14, 3, -20);
PlaceSeeing(52, 6, 3, -10);

CenterOnXY(83, 13);

wait(0$3);

SayRadio(Platonov, 'DIntro-Pla-1');

CenterNowOnUnits(Burlak);

Say(Burlak, 'DIntro-Bur-1');
SayRadio(Platonov, 'DIntro-Pla-2');
Say(Burlak, 'DIntro-Bur-2');

RemoveSeeing(75, 16, 3);
RemoveSeeing(39, 14, 3);
RemoveSeeing(52, 6, 3);

ComMoveXY([Titov, Petrovova, Lipshchin], 63, 38);
AddComWalk([Titov, Petrovova, Lipshchin]);
AddComMoveXY([Titov, Petrovova, Lipshchin], 62, 47);

SayRadio(Platonov, 'DIntro-Pla-3');

for i in [Titov, Petrovova, Lipshchin] do
    begin
    if Crawls(i) then
       ComWalk(i);
    end;

ComEnterUnit(Burlak, ruVehicles[1]);
AddComEnterUnit(Titov, UnitFilter(ruVehicles, [f_tag, 1])[1]);
AddComEnterUnit(Petrovova,  UnitFilter(ruVehicles, [f_tag, 5])[1]);
AddComEnterUnit(Lipshchin,  UnitFilter(ruVehicles, [f_tag, 7])[1]);

CenterOnXY(54, 57);

repeat
 wait(0$1);
until not UnitFilter(ruVehicles, [f_empty]);

ComMoveXY(ruVehicles, 4, 4);

wait(0$1);

CenterOnXY(22, 17);

wait(0$4);

ComMoveXY(arVehicles, 38, 15);

wait(0$5);

PlaceSeeing(59, 15, 3, -15);

CenterOnXY(59, 15);

wait(0$6);

ChangeMap(1, '%_cont');
End;

On DialogueSkipped(p) do
begin
ChangeMap(1, '%_cont');
End;