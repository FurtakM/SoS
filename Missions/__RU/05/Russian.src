Export Burlak, Platonov, Petrovova, Titov,
       Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov;
Export ruVehicles;
Export function PrepareRussian;
var i, veh;
begin
uc_nation := nation_russian;
uc_side := 6;

Platonov  := NewCharacter('Platonov');

uc_side := 3;

Burlak    := PrepareUnit('Burlak', (not debug), prevMissionPrefix);
Karamazov := NewCharacter('Karamazov');
Lipshchin := NewCharacter('Lipshchin');
Petrosyan := NewCharacter('Petrosyan');
Titov     := NewCharacter('Titov');
Petrovova := NewCharacter('Petrovova');
Gleb      := NewCharacter('Gleb');
Dolgov    := NewCharacter('Dolgov');

ruVehicles := [];

PrepareVehicle(ru_medium_tracked, engine_combustion, control_manual, ru_gun, 80);
veh := CreateVehicle;
SetDir(veh, 5);
SetMark(veh, -3);

ruVehicles := Join(ruVehicles, veh);
PlaceUnitArea(veh, startArea0, false);

for i := 1 to 2 do
    begin
    PrepareVehicle(ru_medium_tracked, engine_combustion, control_manual, [ru_gatling_gun, ru_heavy_machine_gun][i], 80);
    veh := CreateVehicle;
    SetDir(veh, 5);
    SetTag(veh, i);

    ruVehicles := Join(ruVehicles, veh);
    PlaceUnitArea(veh, startArea1, false);
    end;   

for i := 1 to 2 do
    begin
    PrepareVehicle(ru_medium_tracked, engine_combustion, control_manual, ru_cargo_bay, 80);
    veh := CreateVehicle;
    SetDir(veh, 5);
    SetCargo(veh, mat_oil, 30);
    SetTag(veh, 2 + i);

    ruVehicles := Join(ruVehicles, veh);
    PlaceUnitArea(veh, startArea2, false);
    end;

for i := 1 to 3 do
    begin
    PrepareVehicle(ru_medium_tracked, engine_combustion, control_manual, ru_heavy_machine_gun, 80);
    veh := CreateVehicle;
    SetDir(veh, 0);
    SetTag(veh, 4 + i);

    ruVehicles := Join(ruVehicles, veh);
    PlaceUnitArea(veh, startArea3, false);
    end;

// spawn
for i in [Titov, Petrovova, Lipshchin] do
    begin
    PlaceUnitArea(i, spawnSpotArea, false);
    SetDir(i, 0);
    end;


ComMoveXY(Titov, 65, 38);
AddComCrawl(Titov);

ComMoveXY(Lipshchin, 62, 35);
AddComCrawl(Lipshchin);

ComMoveXY(Petrovova, 60, 35);
AddComCrawl(Petrovova);

PlaceUnitArea(Burlak, burlakArea, false);
ComTurnUnit(Burlak, Titov);

for i in ruVehicles do
    begin
    case GetTag(i) of
         2: PlaceHumanInUnit(Gleb, i);
         3: PlaceHumanInUnit(Dolgov, i);
         4: PlaceHumanInUnit(Karamazov, i);
         6: PlaceHumanInUnit(Petrosyan, i);
         end;
    end;
End;