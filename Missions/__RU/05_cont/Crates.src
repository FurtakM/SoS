Every 1$20 + 0$40 trigger GetResourceArea(cratesRiverArea, mat_cans) < [15, 12, 12, 12][Difficulty] do
begin
enable;
CreateCratesArea(rand(1, 5), cratesRiverArea, true);
End;

Every 0$40 + 0$40 trigger GetResourceArea(cratesForestArea, mat_cans) < 10 and tick < [25$0, 15$0, 12$0, 11$0][Difficulty] do
begin
enable;
CreateCratesArea(rand(1, 5), cratesForestArea, true);
End;

Every 0$30 + 1$00 trigger GetResourceArea(southCratesArea, mat_cans) < 14 do
begin
enable;
CreateCratesArea(rand(1, 5), southCratesArea, true);
End;

Every 1$00 + 0$30 trigger tick < 6$10 do
begin
enable;
CreateCratesXYR(rand(1, 5), 69, 63, 12, true);
End;
