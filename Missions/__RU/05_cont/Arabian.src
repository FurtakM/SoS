Export Omar, Heike;
Export function PrepareArabian;
begin
uc_side := 2;
uc_nation := nation_arabian;

Heike := NewCharacter('Heike');
Omar := NewCharacter('Omar');
End;

Export arForces, omarMastodont, enemyMines, arBuildings, arBuildingsToBuild, arVehicles, arConstructList, arTechs,
       arHovercraft, arVehiclesAttackers, arDepot, arPatrolRiver, arPatrolRiverFlag, riverBlockers;
Export function PrepareArabianBase;
var i, j, depot, list, un, tmp;
begin
arForces := [];
enemyMines := [];
arBuildingsToBuild := [
    [b_solar_power, 134, 45, 0],
    [b_solar_power, 136, 44, 3],
    [b_bunker, 128, 74, 0],
    [b_bunker, 149, 76, 5]
];
arConstructList := [];
arVehicles := [];
arHovercraft := [];
arPatrolRiver := [];
arPatrolRiverFlag := [];
arVehiclesAttackers := [];
arTechs := GetTechNation(2, 2, state_enabled);

uc_side := 2;
uc_nation := nation_arabian;

bc_level := [3, 4, 5, 5][Difficulty];

depot := PlaceBuildingInArea(b_depot, 2, depotArea);
arDepot := depot;

SetResourceType(GetBase(depot), mat_cans, 500);
SetResourceType(GetBase(depot), mat_oil, 150);

PlaceBuildingInArea(b_oil_mine, 4, oilArea);
PlaceBuildingInArea(b_oil_power, 1, plant1Area);
PlaceBuildingInArea(b_oil_power, 4, plant2Area);

bc_kind1 := b_lab_weapon;
bc_kind2 := b_lab_basic;

tmp := PlaceBuildingInArea(b_lab, 2, labArea);

for i := 1 to 2 do
    begin
    PrepareScientist(false, [3, 4, 5, 5][Difficulty]);
    un := CreateHuman;

    Push(arForces, un);
    PlaceHumanInUnit(un, tmp);
    end;

InitBc;

bc_level := [3, 4, 5, 5][Difficulty];

tmp := PlaceBuildingInArea(b_factory, 4, facArea);

for i := 1 to [5, 6, 6, 6][Difficulty] do
    begin
    PrepareMechanic(false, [3, 4, 5, 5][Difficulty]);
    un := CreateHuman;

    Push(arForces, un);
    PlaceHumanInUnit(un, tmp);
    end;

list := GetFacExtXYD(GetX(tmp), GetY(tmp), 4);

bc_type := b_ext_gun;
CreateAndPlaceBuildingXYD(list[4][1], list[4][2], list[4][3]);

bc_type := b_ext_track;
CreateAndPlaceBuildingXYD(list[5][1], list[5][2], list[5][3]);

bc_type := b_ext_stitch;
CreateAndPlaceBuildingXYD(list[3][1], list[3][2], list[3][3]);

tmp := [
    PlaceBuildingInArea(b_breastwork, 1, bun1Area),
    PlaceBuildingInArea(b_breastwork, 1, bun2Area)
];

for i in tmp do
    begin
    PrepareSoldier(false, [3, 4, 5, 6][Difficulty]);
    un := CreateHuman;

    Push(arForces, un);

    SetDir(un, 4);
    PlaceHumanInUnit(un, i);
    end;

{tmp := [
    PlaceBuildingInArea(b_bunker, 0, tw1Area),
    PlaceBuildingInArea(b_bunker, 5, tw2Area)
];

for i in tmp do
    begin
    PlaceWeaponTurret(i, [ar_gun, ar_double_machine_gun][i mod 2 + 1]);
    PrepareSoldier(false, [3, 4, 5, 5][Difficulty]);
    un := CreateHuman;

    Push(arForces, un);

    PlaceHumanInUnit(un, i);
    end;}

tmp := [
    PlaceBuildingInArea(b_barracks, 1, bar1Area),
    PlaceBuildingInArea(b_barracks, 5, bar2Area)
];

for i in tmp do
    begin
    for j := 1 to [2, 3, 4, 5][Difficulty] do
        begin
        PrepareSoldier(false, [3, 4, 5, 6][Difficulty]);
        un := CreateHuman;

        if j mod 2 = 0 then
           SetClass(un, class_mortar);

        Push(arForces, un);

        PlaceHumanInUnit(un, i);
        end;
    end;

for i := 1 to 3 do
    begin
    PrepareEngineer(false, [3, 4, 4, 5][Difficulty]);
    hc_attr := [12, 12];
    un := CreateHuman;

    Push(arForces, un);

    PlaceHumanInUnit(un, depot);
    end;

InitHc_All();

PrepareMastodont();
uc_side := 2;

omarMastodont := CreateVehicle;
PlaceUnitXYR(omarMastodont, 136, 69, 3, false);

PlaceHumanInUnit(Omar, omarMastodont);

arBuildings := FilterAllUnits([[f_side, 2], [f_type, unit_building]]);
     
SetTag(un, tCamera);

ComExitBuilding(un);

list := AreaToList(camArea, 0);

for i := 1 to list[1] do
    begin
    AddComHiddenCamera(un, list[1][i], list[2][i]);
    end;

AddComEnterUnit(un, depot);
End;

// mines logic
Every 0$1 trigger arForces do
var i, tmp, r, list, findEmpty;
begin
tmp := UnitFilter(arForces, [[f_class, 1], [f_ok]]);

if not tmp then
   begin
   disable;
   exit;
   end;

list := AreaToList(minefieldArea, 0);

for i in tmp do
    begin
    if not MineOfUnit(i) and not FilterUnitsInArea(minefieldScanArea, [f_enemy, 2]) and not HasTask(i) then
       begin
       if IsInUnit(i) then
          ComExitBuilding(i);

       r := rand(1, list[1]);
       AddComPlaceRemoteCharge(i, list[1][r], list[2][r], 0);

       list := [Delete(list[1], r), Delete(list[2], r)];

       wait(3);

       findEmpty := FilterAllUnits([[f_side, 2], [f_type, unit_building], [f_tag, tEmpty]]);

       if not findEmpty then
          AddComMoveXY(i, 131, 68)
       else
          begin
          AddComEnterUnit(i, findEmpty[1]);
          SetTag(findEmpty[1], tReserved);
          end;
       end;
    end;

enable;
End;

Every 0$10 trigger arabSpotted do
var chassis, weapon;
begin
wait(5$00 - (1$00 * Difficulty) + timeToArabAttack);

arConstructList := [
   [ar_hovercraft, engine_combustion, control_manual, ar_double_machine_gun],
   [ar_half_tracked, engine_combustion, control_manual, ar_cargo_bay],
   [ar_half_tracked, engine_combustion, control_manual, ar_gun],
   [ar_half_tracked, engine_combustion, control_manual, ar_flame_thrower],
   [ar_half_tracked, engine_combustion, control_manual, ar_gatling_gun],
   [ar_hovercraft, engine_combustion, control_manual, ar_double_machine_gun]
];

repeat
 wait(0$10);
until arVehiclesAttackers >= 2;

arAllowToAttack := true;
End;

Every 0$1 trigger arForces do
begin
{ BaseScript(side, area, cratesArea, innerArea, outerArea, forces,
                           vehicles, techs, constructList, buildingsToBuild,
                           healPoint, parkingPoint, allowToPatrol); }
BaseScript(2, arabianBaseArea, arabianBaseArea, arabianBaseArea, arabianBaseOuterArea,
           arForces, arVehicles, arTechs, arConstructList, arBuildingsToBuild,
           [136,70], [134,67], []);
enable;
End;

Every 1 trigger enemyMines and FilterUnitsInArea(minefieldArea, [f_enemy, 2]) do
var i, e;
begin
enable;

for i in enemyMines do
    begin
    e := HexInfo(i[1], i[2]);

    if not e then
       continue;

    if GetSide(e) in [3, 6] then
       LaunchMineAtPos(i[1], i[2], 2);
    end;
End;

                                       
Every 0$1 trigger arVehiclesAttackers and arAllowToAttack do
var i, mech, enemy;
begin
enable;

if not arVehiclesAttackers then
   exit;

// tags:
// 0 - idle,
// 1 - go to parking, repair if needed
// 2 - attack

for i in arVehiclesAttackers do
    begin
    if not IsOk(i) or GetSide(i) <> 2 then
       begin
       arVehiclesAttackers := arVehiclesAttackers diff i;
       continue;
       end;

    if GetTag(i) = 300 then
       begin
       if GetFuel(i) < 50 then
          begin
          ComMoveXY(i, 128, 63);

          repeat
           wait(0$1);
          until GetDistUnitXY(i, 128, 63) < 4;

          SetFuel(i, 100);
          end
       else if not IsInArea(i, arParkingArea) then
          ComMoveToArea(i, arParkingArea)
       else
          SetTag(i, 301);
       end;

    if GetTag(i) = 301 then
       begin
       if GetLives(i) < 1000 then
          begin
          if not IsDrivenBy(i) then
             continue;

          mech := IsDrivenBy(i);

          ComExitVehicle(mech);
          AddComRepairVehicle(mech, i);

          repeat
           wait(0$1);
          until GetLives(i) = 1000;

          SetLives(mech, 1000);
          ComEnterUnit(mech, i);
          end
       else if IsDrivenBy(i) then
          SetTag(i, 0);
       end;

    if GetTag(i) < 300 then
       begin
       enemy := FilterUnitsInArea(arabianBaseArea, [f_enemy, 2]);

       if GetLives(i) < 650 then
          begin
          ComStop(i);
          SetTag(i, 300);
          continue;
          end;

       if enemy then
          begin
          if not HasTask(i) then
             ComAttackUnit(i, NearestUnitToUnit(enemy, i));
          end
       else if arVehiclesAttackers then
          begin
          enemy := FilterAllUnits([f_enemy, 2]);

          if enemy then
             AgressiveMove(i, [ [110,66], [95,68], [84,67] ]);
          end;
       end;
    end;
End;

Every 0$1 trigger arPatrolRiver do
var i, path, tag;
begin
path := [
  [152, 119],
  [133, 90],
  [110, 84],
  [103, 97],
  [92, 103],
  [79, 102],
  [60, 90],
  [45, 74],
  [36, 56],
  [33, 37],
  [40, 27],
  [53, 24],
  [64, 23],
  [86, 31],
  [107, 46]
];

repeat
 wait(0$0.3);

 for i in UnitFilter(arPatrolRiver, [f_ok]) do
     begin
     tag := GetTag(i);

     if GetLives(i) < 1000 then
        begin
        if tag = 0 then
           begin
           if GetFuel(i) < 30 then
              ComMoveUnit(i, arDepot)
           else if not IsInArea(i, arabianBaseArea) then
              ComMoveToArea(i, arParkingArea)
           else
              ComRepairVehicleAndReturn(IsDrivenBy(i));
           end
        else
           begin
           if not IsAt(i, path[tag][1], path[tag][2]) then
              ComMoveXY(i, path[tag][1], path[tag][2])
           else
              SetTag(i, tag - 1);
           end;
        end
     else
        begin
        if tag = 0 then
           begin
           if GetFuel(i) < 30 then
              ComMoveUnit(i, arDepot)
           else
              begin
              arPatrolRiverFlag := Replace(arPatrolRiverFlag, i, 0);
              SetTag(i, 1);
              end;
           end
        else if tag = Count(path) then
           begin
           arPatrolRiverFlag := Replace(arPatrolRiverFlag, i, 1);
           SetTag(i, Count(path) - 1);
           end
        else if arPatrolRiverFlag[i] then
           begin
           if not IsAt(i, path[tag][1], path[tag][2]) then
              ComAgressiveMove(i, path[tag][1], path[tag][2])
           else
              SetTag(i, tag - 1);
           end
        else
           begin
           if not IsAt(i, path[tag][1], path[tag][2]) then
              ComAgressiveMove(i, path[tag][1], path[tag][2])
           else
              SetTag(i, tag + 1);
           end;
        end;
     end;
until not arPatrolRiver;
End;

Every 0$3 trigger FilterAllUnits([[f_side, 2], [f_ok], [f_weapon, ar_cargo_bay]]) do
var i, cargo, cr;
begin
cargo := FilterAllUnits([[f_side, 2], [f_ok], [f_weapon, ar_cargo_bay]]);

for i in cargo do
    begin
    if GetFuel(i) < 10 then
       begin
       ComMoveUnit(i, arDepot);
       continue;
       end;

    if GetLives(i) < 1000 and IsInArea(i, arabianBaseArea) then
       begin
       ComRepairVehicleAndReturn(IsDrivenBy(i));
       continue;
       end;

    if HasTask(i) or not IsDrivenBy(i) then
       continue;

    cr := GetListOfCratesInArea(cratesRiverArea);

    if cr then
       ComCollect(cargo, cr[1], cr[2]);
    end;

enable;
End;

Export function AttackFromRiver(vehicle);
var i, units, unit, mech, mechs, enemy, nearest, vehicles, veh;
begin
if not IsOk(vehicle) then
   exit;

units := UnitFilter(arForces, [[f_ok], [f_class, class_soldier]]);

if not units then
   exit;

for i in units do
    if IsInUnit(i) and GetBType(IsInUnit(i)) in [b_breastwork, b_bunker] then
       continue
    else
       begin
       unit := i;
       break;
       end;

if not unit then
   exit;

arForces := arForces diff unit;

if IsInUnit(unit) then
   ComExit(unit);

AddComEnterUnit(unit, vehicle);

repeat
 wait(0$1);
until IsInUnit(unit);

ComMoveXY(unit, 83, 104);
AddComMoveXY(unit, 50, 80);
AddComMoveXY(unit, 41, 66);
AddComMoveXY(unit, 50, 68);

repeat
 wait(0$1);
until IsInArea(unit, bankArea) or (IsDrivenBy(unit) and IsInArea(IsDrivenBy(unit), bankArea));

ComExitVehicle(unit);

repeat
 wait(0$1);
until not IsInUnit(unit);

repeat
 wait(0$0.3);
 enemy := FilterAllUnits([f_enemy, 2]);

 nearest := NearestUnitToUnit(UnitFilter(enemy, [[f_not, [f_tag, tMined]], [f_type, unit_building]]), unit);

 if not nearest then
    begin
    vehicles := FilterAllUnits([[f_side, 3], [f_type, unit_vehicle], [f_empty]]);

    if vehicles then
       begin
       veh := NearestUnitToUnit(vehicles, unit);

       ComEnterUnit(unit, veh);
       AddComMoveXY(unit, 136, 68);

       repeat
        wait(0$1);
       until IsInArea(unit, arParkingArea) and not HasTask(unit);

       ComExitVehicle(unit);
       SetTag(unit, 0);

       Push(arForces, unit);

       for i in FilterAllUnits([f_tag, tMined]) do
           SetTag(i, 0);

       mechs := UnitFilter(arForces, [f_class, class_mechanic]);

       if not mechs then
          exit;

       for i in mechs do
           if IsInUnit(i) and GetBType(IsInUnit(i)) = b_factory then
              begin
              mech := i;
              break;
              end;

       if not mech then
          exit;

       wait(0$1);

       veh := FilterUnitsInArea(arabianBaseArea, [[f_side, 2], [f_nation, 3], [f_empty], [f_type, unit_vehicle]]);

       if not veh then
          exit;

       veh := veh[1];

       if GetWeapon(veh) = ru_cargo_bay then
          begin
          SetTag(mech, tMech);

          ComExitBuilding(mech);

          repeat
           wait(3);
          until not IsInUnit(mech);

          ComEnterUnit(mech, veh);
          AddComUnload(mech);
          AddComRecycle(mech, FilterAllUnits([[f_side, 2], [f_btype, b_factory]])[1]);

          repeat
           wait(0$1);
          until IsInUnit(mech);
          end
       else
          begin
          SetTag(mech, tMech);

          ComExitBuilding(mech);

          repeat
           wait(3);
          until not IsInUnit(mech);

          ComEnterUnit(mech, veh);

          repeat
           wait(0$1);
          until IsInUnit(mech) = veh;

          Push(arVehiclesAttackers, veh);
          end;

       exit;
       end;
    end
 else if not HasTask(unit) then
    begin
    ComPlaceDelayedCharge(unit, 0, 0, nearest);

    repeat
     wait(3);
    until GetLives(nearest) < 1000;

    SetTag(nearest, tMined);
    end;
until IsDead(unit);

for i in FilterAllUnits([f_tag, tMined]) do
    SetTag(i, 0);
End;

Every 0$3 trigger FilterAllUnits([[f_side, 2], [f_engine, engine_combustion]]) do
var i;
begin
enable;

for i in FilterAllUnits([[f_side, 2], [f_engine, engine_combustion]]) do
    if GetFuel(i) < 3 then
       SetFuel(i, 3);
End;

Every 0$1 trigger not IsInArea(omarMastodont, arabianBaseArea) do
begin
enable;
ComMoveXY(omarMastodont, 139, 68);
End;

Export function SpawnRiverBlock;
var i, un, veh;
begin
result := [];

for i := 1 to [2, 2, 3, 3][Difficulty] do
    begin
    uc_side := 2;
    uc_nation := nation_arabian;

    PrepareVehicle(
        [ar_medium_trike, ar_half_tracked][rand(1,2)],
        engine_combustion,
        control_manual,
        [ar_gun, ar_gatling_gun, ar_gun][rand(1,3)],
        90
    );

    veh := CreateVehicle;

    result := Join(result, veh);

    SetDir(veh, 4);

    repeat
     wait(0$0.3);
    until PlaceUnitArea(veh, southSpawnArea, false);

    PrepareMechanic(false, [3, 4, 5, 6][Difficulty]);
    un := CreateHuman;

    result := Join(result, un);

    PlaceHumanInUnit(un, veh);

    ComAgressiveMove(un, 130, 131);
    AddComMoveXY(un, [148, 145, 143, 140][i], [136, 133, 130, 130][i]);
    AddComHold(un);
    end;

for i := 1 to [2, 2, 3, 3][Difficulty] do
    begin
    PrepareSoldier(false, [3, 4, 4, 5][Difficulty]);
    un := CreateHuman;

    result := Join(result, un);

    SetClass(un, class_mortar);
    SetDir(un, 4);

    repeat
     wait(0$0.3);
    until PlaceUnitArea(un, southSpawnArea, false);

    ComMoveToArea(un, mortarRiverArea);
    end;
End;