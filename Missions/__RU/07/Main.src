// Mission 7

Starting
begin
ResetFog;
Init;

PrepareArabian;
PrepareRussian;

if debug then
   FogOff(3);

Action;
End;

Export debug, prevMissionPrefix, prevMissionPrefixVse, hasVsevolod, seviPoint, xavierOnPatrol, arabDefeat,
       hasClearPath, arAllowToAttack;
Function Init;
begin
debug := 1;

if debug then
   Difficulty := 4;

prevMissionPrefix := '06_';
prevMissionPrefixVse := '06_Vse_';
hasVsevolod := LoadVariable('06_VsevolodSaved', debug);
xavierOnPatrol := false;
arAllowToAttack := false;
seviPoint := [
  [99, 94],
  [135, 95],
  [160, 81],
  [202, 149]
];
arabDefeat := false;
hasClearPath := false;
End;

Every 0$1 trigger debug do
var i;
begin
enable;

debug_strings := [];

for i in FilterAllUnits([[f_side, 2], [f_hastask], [f_type, unit_human]]) do
    debug_strings := debug_strings ^ i;
End;