// Mission 7

Starting
begin
ResetFog;
Init;

// birds, tigers, apemans, enchidnas, horses, mastodonts, fishes
PrepareNature(6, 6, 2, 3, 1, 0, 0, natureArea, 0);
PrepareNature(0, 0, [12, 11, 10, 9][Difficulty], 0, 0, 0, 0, apeArea, 0);

PrepareArabian;
PrepareRussian;

if debug then
   FogOff(3);

Action;
End;

Export debug, prevMissionPrefix, prevMissionPrefixVse, currentMissionPrefix, hasVsevolod, seviPoint, xavierOnPatrol, arabDefeat, canSaveHeike,
       hasClearPath, arAllowToAttack, destroyCounter, yashinSuccessfullEvacuated, launchedMine, hasMinefieldPlan, hasHeike;
Function Init;
begin
debug := 1;

if debug then
   Difficulty := 4;

prevMissionPrefix := '06_';
prevMissionPrefixVse := '06_Vse_';
hasVsevolod := LoadVariable('06_VsevolodSaved', false); //debug);
currentMissionPrefix := '07_';
xavierOnPatrol := false;
arAllowToAttack := false;
launchedMine := false;
canSaveHeike := false;
destroyCounter := 0;
hasHeike := false;
seviPoint := [
  [99, 94],
  [135, 95],
  [160, 81],
  [202, 149]
];
arabDefeat := false;
hasClearPath := false;
yashinSuccessfullEvacuated := false;
hasMinefieldPlan := false;
End;

