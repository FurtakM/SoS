// Mission 7

Starting
begin
ResetFog;
Init;

PrepareArabian;
PrepareRussian;
Action;

if debug then
   FogOff(3);
End;

Export debug, prevMissionPrefix, prevMissionPrefixVse, hasVsevolod;
Function Init;
begin
debug := 1;
prevMissionPrefix := '06_';
prevMissionPrefixVse := '06_Vse_';
hasVsevolod := LoadVariable('06_VsevolodSaved', debug);
End;