Every 2$40 trigger GetResourceArea(cratesForestArea, mat_cans) < 20 do
begin
enable;

CreateCratesArea(rand(1, 5), cratesForestArea, true);
End;

Every 3$40 trigger GetResourceArea(cratesArabArea, mat_cans) < 7 do
begin
enable;

CreateCratesArea(rand(1, 5), cratesArabArea, true);
CreateCratesArea(rand(1, 5), cratesArabArea, true);
End;

Every 0$05 do
var i;
begin 
repeat
 wait(rand(0$40, 1$20));

 for i in [crates1Area, crates2Area, crates3Area, crates4Area, crates5Area, crates6Area] do
     if GetResourceArea(i, mat_cans) < 12 and Prob(50) then
        CreateCratesArea(rand(1, 5), i, true);
until false;
End;