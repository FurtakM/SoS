// events here
On UnitDestroyed(unit) do
begin
if unit = Vsevolod then
   begin
   YouLost('Sevi');
   exit;
   end;

if unit = Burlak then
   begin
   YouLost('Burlak');
   exit;
   end;

if unit = Yashin then
   begin
   YouLost('Yashin');
   exit;
   end;
End;

On Contact(s1, s2) do
begin
if s1 = 3 and s2 = 6 then
   begin
   YouLost('AllyAttacked');
   exit;
   end;
End;

On EvacuateVehicle(driver, abandoned_vehicle, unknown1, unknown2) do
var fac;
begin
if GetTag(driver) = tEscape and GetSide(driver) = 2 then
   begin
   repeat
    if IsAt(driver, 142, 27) then
       begin
       RemoveUnit(driver);
       exit;
       end;

    ComMoveXY(driver, 142, 27);
    wait(0$1);
   until not IsOk(driver);

   exit;
   end;

if GetTag(driver) = tMech then
   SetTag(driver, 0);

if GetSide(driver) = 2 then
   begin
   fac := FilterAllUnits([[f_side, 2], [f_btype, b_factory], [f_ok]]);

   if fac then
      ComEnterUnit(driver, fac[1]);
   end;
End;

On BuildingComplete(b) do
var side, btype;
begin
side := GetSide(b);
btype := GetBType(b);

if side = 2 then
   if IsInArea(b, kabulBaseArea) then
      arBuildingsToBuild := Delete(arBuildingsToBuild, 1)
   else if GetBType(b) = b_bunker then
         AddComPlaceWeapon(b, [ar_gun, ar_gatling_gun][rand(1,2)])
      else if GetBType(b) = b_armoury then
         ComUpgrade(b);
End;


On UpgradeComplete(b) do
var side, btype;
begin
side := GetSide(b);
btype := GetBType(b);

if side = 2 and IsInArea(b, kabulBaseArea) then
   arBuildingsToBuild := Delete(arBuildingsToBuild, 1);
End;

On ResearchComplete(tech, lab) do
var side;
begin
side := GetSide(lab);

if side = 2 then
   arTechs := arTechs diff tech;
End;     

On VehicleConstructed(vehicle, factory) do
var side, driver, i;
begin
SOS_VehicleConstructed(vehicle, factory);

side := GetSide(vehicle);

if side = 2 then
   begin
   driver := IsDrivenBy(vehicle);

   if driver then
      SetTag(driver, tMech);

   for i := 1 to arConstructList do
       if GetWeapon(vehicle) = arConstructList[i][4] then
          begin
          arConstructList := Delete(arConstructList, i);
          break;
          end;

   if GetControl(vehicle) = control_manual then
      begin
      if Count(arVehicles) < 3 or GetWeapon(vehicle) in [ar_cargo_bay, ar_crane, ar_control_tower] then
         arVehicles := Join(arVehicles, vehicle)
      else
         arAttackVehiclesTmp := Join(arAttackVehiclesTmp, vehicle);
      end
   else
     begin
     if GetWeapon(vehicle) in [ar_cargo_bay, ar_crane, ar_control_tower] then
        arVehicles := Join(arVehicles, vehicle)
     else if GetWeapon(vehicle) = ar_flame_thrower and not hasClearPath then
        ClearRoadInForest(vehicle)
     else
        arAttackVehiclesTmp := Join(arAttackVehiclesTmp, vehicle);
     end;

   if arAttackVehiclesTmp >= [3, 4, 5, 5][Difficulty] then
      begin
      arAttackVehicles := arAttackVehicles union arAttackVehiclesTmp;
      arAttackVehiclesTmp := [];
      end;
   end;
End;

On ClassChanged(un, oldClass, newClass) do
var tag;
begin
tag := GetTag(un);

if tag in [tWannaBeMech, tWannaBeSol] then
   SetTag(un, 0);
End;

On EnterBuilding(b, un) do
begin
if GetBType(b) = b_factory and GetSide(un) = 2 then
   SetLives(un, 1000);
End;


