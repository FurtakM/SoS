Export function Action;
begin
if hasVsevolod then
   SeviScene
else
   NormalScene;
End;

Function SeviScene;
var i;
begin
InGameOn;

CenterNowOnUnits(Burlak);

ComMoveUnit(Burlak, Vsevolod);
ComMoveUnit(Vsevolod, Burlak);

repeat
 wait(0$1);
until GetDistUnits(Burlak, Vsevolod) < 6;

ComTurnUnit(Burlak, Vsevolod);
ComTurnUnit(Vsevolod, Burlak);

Say(Burlak, 'DMeetVsevolodVS-Bur-1');
          
CenterOnXY(59, 54);

PlaceSeeing(59, 54, 3, -12);
RemoveSeeing(59, 54, 3);

Say(Vsevolod, 'DMeetVsevolodVS-Vse-1');

wait(0$2);

CenterOnUnits(Burlak);

Say(Burlak, 'DMeetVsevolodVS-Bur-2');
Say(Vsevolod, 'DMeetVsevolodVS-Vse-2');

CenterOnUnits(Burlak);

InGameOff;

ChangeMissionObjectives('MStart');
ChangeMissionObjectives('MVsevolod');

SaveForQuickRestart;

ComMoveXY(Vsevolod, 84, 116);

wait(0$2);

for i in FilterAllUnits([[f_side, 6], [f_type, unit_human]]) diff Vsevolod do
    ComMoveXY(i, 89, 125);
End;

Function NormalScene;
begin

End;