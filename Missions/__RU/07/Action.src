Export function Action;
begin
if hasVsevolod then
   SeviScene
else
   NormalScene;
End;

Function SeviScene;
var i;
begin
InGameOn;

RevealMapOnXY(55, 91, 3, -16);

CenterNowOnUnits(Burlak);

ComHold(Burlak);

ComMoveXY(Vsevolod, 98, 164);
AddComMoveUnit(Vsevolod, Burlak);

for i in FilterAllUnits([[f_side, 6], [f_type, unit_human]]) diff Vsevolod do
    ComMoveXY(i, 103, 154);

SayRadio(Platonov, 'DStart-Pla-1');
SayRadio(Platonov, 'DStartVS-Pla-1');
SayRadio(Platonov, 'DStart2-Pla-1');
Say(Burlak, 'DStart2-Bur-1');

// ComMoveUnit(Burlak, Vsevolod);

repeat
 wait(0$1);
until GetDistUnits(Burlak, Vsevolod) < 6 or dialogue_skipped;

ComTurnUnit(Burlak, Vsevolod);
ComTurnUnit(Vsevolod, Burlak);

Say(Burlak, 'DMeetVsevolodVS-Bur-1');
          
CenterOnXY(59, 54);

RevealMapOnXY(59, 54, 3, -12);
RevealMapOnXY(67, 115, 3, -6);

Say(Vsevolod, 'DMeetVsevolodVS-Vse-1');

wait(0$1);

CenterOnXY(55, 91);

wait(0$1);

CenterOnUnits(Burlak);

Say(Burlak, 'DMeetVsevolodVS-Bur-2');
Say(Vsevolod, 'DMeetVsevolodVS-Vse-2');

CenterOnUnits(Burlak);

ComMoveXY(Vsevolod, 84, 116);
AddComMoveXY(Vsevolod, 74, 98);

for i := 1 to Difficulty do
    AddComMoveXY(Vsevolod, seviPoint[i][1], seviPoint[i][2]);

wait(0$3);

for i in FilterAllUnits([[f_side, 6], [f_type, unit_building]]) do
    SetSide(i, 3);

InGameOff;

ChangeMissionObjectives('MStart');

SaveForQuickRestart;

repeat
 wait(0$1);

 for i in FilterAllUnits([[f_side, 6], [f_type, unit_human]]) diff Vsevolod do
     begin
     if GetDistUnits(i, Vsevolod) > 6 then
        ComMoveUnit(i, Vsevolod)
     else
        ComStop(i);
     end;
until IsAt(Vsevolod, seviPoint[Difficulty][1], seviPoint[Difficulty][2]);

MineExplosion(GetX(Vsevolod) - 2, GetY(Vsevolod) - 1, 0);
SetLives(Vsevolod, 230 - (20 * Difficulty));

wait(0$02);

CenterNowOnUnits(Vsevolod);

DialogueOn;

Say(Kirilenkova, 'DStasisVS-Kir-1');
Say(Titov, 'DStasisVS-Tit-1');
Say(Burlak, 'DStasisVS-Bur-1');

if GetSide(Titov) = 6 then
   Say(Titov, 'DStasisVS-Tit-2')
else
   Say(Kirilenkova, 'DStasisVS-Kir-2');

SayRadio(Popov, 'DStasisVS-Pop-2');
Say(Gleb, 'DStasisVS-Glb-2');
Say(Burlak, 'DStasisVS-Bur-2');

DialogueOff;

ChangeMissionObjectives('MVsevolod');

for i in FilterAllUnits([f_side, 6]) do
    SetSide(i, 3);

repeat
 wait(0$1);
until IsOk(Vsevolod);

DialogueOn;

Say(Burlak, 'DSeviSaved-Bur-1');
Say(Vsevolod, 'DSeviSaved-Vse-1');
Say(Burlak, 'DSeviSaved-Bur-2');
Say(Vsevolod, 'DSeviSaved-Vse-2');

DialogueOff;

wait(2$00);

if not IsOk(Kirilenkova) then
   exit;

SpawnXavier;

wait(4$30 - (1$0 * Difficulty));

arAllowToAttack := true;
End;

Function NormalScene;
begin
InGameOn;

CenterNowOnUnits(Burlak);

SayRadio(Platonov, 'DStart-Pla-1');
SayRadio(Platonov, 'DStartNV-Pla-1');
SayRadio(Platonov, 'DStart2-Pla-1');
Say(Burlak, 'DStart2-Bur-1');

InGameOff;

ChangeMissionObjectives('MStart');

SaveForQuickRestart;

repeat
 wait(0$1);
until FilterAllUnits([[f_side, 3], [f_not, [f_constructed]], [f_or, [f_btype, b_depot], [f_btype, b_warehouse]]]);

wait(2$00);         

SpawnXavier;

wait(4$30 - (1$0 * Difficulty));

arAllowToAttack := true;
End;     

Function SpawnXavier;
var i, depot, tmp, decision, x, y, d;
begin
repeat
 wait(0$1);
 tmp := FilterAllUnits([[f_side, 3], [f_or, [f_btype, b_depot], [f_btype, b_warehouse]]]);

 if IsDead(Kirilenkova) then
    exit;

 if tmp then
    begin
    depot := NearestUnitToUnit(tmp, Kirilenkova);

    if GetDistUnits(depot, Kirilenkova) < 12 and not IsInUnit(Kirilenkova) then
       break;
    end;
until false;

uc_side := 5;
uc_nation := nation_arabian;

Xavier := NewCharacter('Xavier');
PlaceUnitXYR(Xavier, GetX(Kirilenkova), GetY(Kirilenkova), 6, true);

InGameOn;

CenterNowOnUnits(Xavier);
                       
ComTurnUnit(Kirilenkova, Xavier);

wait(0$02);

ComTurnUnit(Xavier, Kirilenkova);

Say(Xavier, 'DMeetXavier-Xav-1');
Say(Kirilenkova, 'DMeetXavier-Kir-1');
Say(Xavier, 'DMeetXavier-Xav-2');

decision := Query('QXavier');

if decision = 1 then
   begin
   Say(Kirilenkova, 'DQrXavier#1-Kir-1');
   Say(Xavier, 'DQrXavier#1-Xav-1');
   Say(Kirilenkova, 'DQrXavier#1-Kir-2');
   Say(Xavier, 'DQrXavier#1-Xav-2');
   Say(Kirilenkova, 'DQrXavier#1-Kir-3');
   Say(Xavier, 'DQrXavier#1-Xav-3');
   Say(Kirilenkova, 'DQrXavier#1-Kir-4');
   Say(Gleb, 'DQrXavier#1-Glb-4');

   x := GetX(Xavier);
   y := GetY(Xavier);
   d := GetDir(Xavier);

   RemoveUnit(Xavier);
   Xavier := NewCharacter('Xavier2');
   PlaceUnitXYD(Xavier, x, y, d, false);
   SetSide(Xavier, 3);

   InGameOff;
   exit;
   end
else
   begin
   Say(Burlak,'DQrXavier#2-Bur-1');
   Say(Kirilenkova,'DQrXavier#2-Kir-1');
   Say(Xavier,'DQrXavier#2-Xav-1');
   Say(Kirilenkova,'DQrXavier#2-Kir-2');
   Say(Xavier, 'DQrXavier#2-Xav-2');
   Say(Kirilenkova, 'DQrXavier#2-Kir-3');
   Say(Xavier, 'DQrXavier#2-Xav-3');
   Say(Kirilenkova, 'DQrXavier#2-Kir-4');
   Say(Xavier, 'DQrXavier#2-Xav-4');
   Say(Kirilenkova, 'DQrXavier#2-Kir-5');
   Say(Gleb, 'DQrXavier#2-Glb-5');

   InGameOff;

   ComMoveXY(Xavier, 121, 93);

   repeat
    wait(0$1);

    if not HasTask(Xavier) then
       ComMoveToArea(Xavier, xavierContactArea);

    if IsDead(Xavier) then
       exit;
   until IsInArea(Xavier, xavierContactArea);

   if IsDead(Kirilenkova) then
      begin
      SetSide(Xavier, 2);
      ComMoveXY(Xavier, 112, 55);
      AddComEnterUnit(Xavier, HexInfo(107, 54));
      exit;
      end;

   XavierPatrol;
   end;
End;

Every 0$25 trigger destroyCounter > 5 and not InBattle(3) do
var yashinQuery, options, unit, p;
begin
repeat
 wait(0$1);
until PlaceUnitXY(Yashin, 103, 178, false);

ComMoveXY(Yashin, 97, 167);

wait(0$8);

DialogueOn;

CenterNowOnUnits(Yashin);

SayRadio(Yashin, 'DYashinArrives-Yas-1');

if IsOk(Vsevolod) then
   Say(Vsevolod, 'DYashinArrives-Vse-1');

Say(Burlak, 'DYashinArrives-Bur-1');
SayRadio(Yashin, 'DYashinArrives-Yas-2');

if IsOk(Vsevolod) then
   begin
   Say(Vsevolod, 'DYashinArrives-Vse-2');
   SayRadio(Yashin, 'DYashinArrives-Yas-3');
   Say(Vsevolod, 'DYashinArrives-Vse-3'); 
   end
else
   begin
   Say(Burlak, 'DYashinArrives-Bur-3');
   SayRadio(Yashin, 'DYashinArrives-Yas-4');
   Say(Burlak, 'DYashinArrives-Bur-4');
   SayRadio(Yashin, 'DYashinArrives-Yas-5');
   end;

Say(Burlak, 'DYashinArrives-Bur-5');
SayRadio(Yashin, 'DYashinArrives-Yas-6');
Say(Burlak, 'DYashinArrives-Bur-6');
SayRadio(Yashin, 'DYashinArrives-Yas-7');

options := [1, 2, 3];

if not UnitFilter([ar_bun2, ar_bun3], [[f_side, 2], [f_ok]]) then
   options := [2, 3];

yashinQuery := SelectiveQuery('QYashinHelp', options);

debug_strings := yashinQuery;

SaveVariable(yashinQuery, '07_YashinQuery');

case yashinQuery of
     1: begin
        Say(Burlak, 'DQrYashinHelp#1-Bur-1');
        SayRadio(Yashin, 'DQrYashinHelp#1-Yas-1');
        Say(Burlak, 'DQrYashinHelp#1-Bur-2');
        SayRadio(Yashin, 'DQrYashinHelp#1-Yas-2');

        SetTech(tech_bazooka, 3, state_enabled);
        end;
     2: begin
        Say(Burlak, 'DQrYashinHelp#2-Bur-1');
        SayRadio(Yashin, 'DQrYashinHelp#2-Yas-1');
        end;
     3: begin
        Say(Burlak, 'DQrYashinHelp#3-Bur-1');
        SayRadio(Yashin, 'DQrYashinHelp#3-Yas-1');
        end;
     end;   

DialogueOff;

repeat
 wait(0$1);

 unit := FilterAllUnits([[f_side, 3], [f_type, unit_building]]);

 if IsIdle(Yashin) then
    if unit then
       ComMoveUnit(Yashin, First(unit))
    else
       ComMoveUnit(Yashin, Burlak);

 if IsDead(Yashin) then
    exit;
until FilterAllUnits([[f_side, 3], [f_dist, Yashin, 12]]);

ComStop(Yashin);

DialogueOn;

Say(Yashin, 'DYashinLeave-Yas-1');
Say(Burlak, 'DYashinLeave-Bur-1');

DialogueOff;

Query('QYashinCar');

p := 0;

repeat
 wait(0$1);
 p := Inc(p);

 if p > 20 then
    begin
    Say(Yashin, 'DYashinLeave-Yas-1');
    p := 0;
    end;
until FilterAllUnits([
        [f_side, 3], [f_empty], [f_control, control_manual], [f_dist, Yashin, 8], [f_type, unit_vehicle],
        [f_nation, 3],
        [f_engine, engine_siberite], [f_or, [f_chassis, ru_medium_wheeled], [f_chassis, ru_medium_tracked]],
        [f_or, [f_not, [f_weapon, ru_cargo_bay]], [f_not, [f_weapon, ru_crane]], [f_not, [f_weapon, ru_bulldozer]], [f_not, [f_weapon, ru_big_cargo_bay]]]
      ]);

unit := FilterAllUnits([
        [f_side, 3], [f_empty], [f_control, control_manual], [f_dist, Yashin, 8], [f_type, unit_vehicle],
        [f_nation, 3],
        [f_engine, engine_siberite], [f_or, [f_chassis, ru_medium_wheeled], [f_chassis, ru_medium_tracked]],
        [f_or, [f_not, [f_weapon, ru_cargo_bay]], [f_not, [f_weapon, ru_crane]], [f_not, [f_weapon, ru_bulldozer]], [f_not, [f_weapon, ru_big_cargo_bay]]]
      ])[1];

SetSide(unit, 6);

repeat
 wait(0$1);
 ComEnterUnit(Yashin, unit);

 if GetSide(unit) <> 6 then
    begin
    SetSide(unit, 6);
    ComExitVehicle(IsDrivenBy(unit));
    end;
until IsInUnit(Yashin);

repeat
 wait(0$1);
 ComMoveXY(Yashin, 116, 177);

 if not IsInUnit(Yashin) then
    begin
    YouLost('YashinEscort');
    exit;
    end;

until IsAt(unit, 116, 177);

RemoveUnit(unit);
RemoveUnit(Yashin);

yashinSuccessfullEvacuated := true;
End;

Every 0$2 trigger (launchedMine or hasMinefieldPlan) and IsOk(Jan) do
begin
RevealMapOnXY(64, 62, 3, -16);
CenterOnXY(64, 62);

Say(Jan, 'DJan-2');
End;

Every 0$2 trigger GetTech(tech_bazooka, 3) = state_researched and IsOk(Jan) do
Say(Jan, 'DJan-1');


Every 0$1 trigger arabDefeat or FilterAllUnits([[f_side, 2], [f_ok], [f_type, unit_human]]) = 0 do
var i, units;
begin
DialogueOn;

SayRadio(Popov, 'DHeikeObj-Pop-1');
Say(Burlak, 'DHeikeObj-Bur-1');
SayRadio(Popov, 'DHeikeObj-Pop-2');
Say(Burlak, 'DHeikeObj-Bur-2');

DialogueOff;

ChangeMissionObjectives('MHeike');

Query('QHeike');

wait(2$00);

units := PrepareHeike;

for i in FilterAllUnits([f_side, 3]) do
    DoNotAttack(7, i);

repeat
 wait(0$1);

 if GetLives(Heike) < 250 then
    begin         
    Del(units, Heike);
    RemoveTasks(Heike);
    SetSide(Heike, 7);
    end;

 if canSaveHeike and GetLives(Heike) >= 250 then
    begin
    ComStop(Heike);
    // SetSide(Heike, 7);

    for i in units do
        begin
        if IsInUnit(i) then
           SetSide(IsInUnit(i), 7);

        SetSide(i, 7);
        ComStop(i);
        end;

    break;
    end;

 for i in units do
     AgressiveMove(i, [ [81,109], [56,70], [77,55], [101,50] ]);
until UnitFilter(units, [f_ok]) = 0;

if canSaveHeike and IsOk(Heike) then
   begin
   DialogueOn;

   Say(Heike, 'DHeikeCapt-Hke-1');
   Say(Burlak, 'DHeikeCapt-Bur-1');
   Say(Heike, 'DHeikeCapt-Hke-2');

   DialogueOff;

   hasHeike := true;
   end;

FinishMission;
End;

Function FinishMission;
var i, saveVehicles;
begin
if IsLive(Xavier) then
   AddMedal('Xavier', 1)
else
   AddMedal('Xavier', -1);

if tick < [85$0, 70$0, 60$0, 45$0][Difficulty] then
   AddMedal('TimeVS', 1)
else
   AddMedal('TimeVS', -1);

if hasHeike then
   AddMedal('Heike', 1)
else
   AddMedal('Heike', -1);

if hasHeike then
   GiveMedals('Main2')
else
   GiveMedals('Main1');

RewardPeople(FilterAllUnits([[f_side, 3], [f_type, unit_human], [f_nation, nation_russian]]));

// Burlak, Petrovova, Titov, Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov, Jan, Vsevolod, Xavier;
SaveCharacters(Burlak, currentMissionPrefix & 'Burlak');

if IsLive(Karamazov) then
   SaveCharacters(Karamazov, currentMissionPrefix & 'Karamazov');  

if IsLive(Petrovova) then
   SaveCharacters(Petrovova, currentMissionPrefix & 'Petrovova'); 

if IsLive(Titov) then
   SaveCharacters(Titov, currentMissionPrefix & 'Titov');

if IsLive(Lipshchin) then
   SaveCharacters(Lipshchin, currentMissionPrefix & 'Lipshchin');

if IsLive(Gleb) then
   SaveCharacters(Gleb, currentMissionPrefix & 'Gleb');

if IsLive(Dolgov) then
   SaveCharacters(Dolgov, currentMissionPrefix & 'Dolgov');

if IsLive(Petrosyan) then
   SaveCharacters(Petrosyan, currentMissionPrefix & 'Petrosyan');

if IsLive(Jan) then
   SaveCharacters(Jan, currentMissionPrefix & 'Jan');

if IsLive(Belkov) then
   SaveCharacters(Belkov, currentMissionPrefix & 'Belkov');

if IsLive(Kirilenkova) then
   SaveCharacters(Kirilenkova, currentMissionPrefix & 'Kirilenkova');

if IsLive(Xavier) then
   SaveCharacters(Xavier, currentMissionPrefix & 'Xavier');

if IsLive(Vsevolod) then
   begin
   SaveCharacters(Vsevolod, 'Vsevolod');
   SaveCharacters(Vsevolod, currentMissionPrefix & 'Vsevolod');
   end;

SaveCharacters(UnitFilter(burlakTeam, [f_ok]) diff [Burlak, Petrovova, Titov, Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov, Xavier, Jan, Vsevolod, Yashin], currentMissionPrefix & 'burlakTeam');

YouWin;
End;


