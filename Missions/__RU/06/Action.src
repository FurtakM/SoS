Export function Action;
var i;
begin
InGameOn;

RevealMapOnXY(198, 230, 3, -8);
RevealMapOnXY(195, 220, 3, -8);
RevealMapOnXY(192, 212, 3, -8);
RevealMapOnXY(187, 203, 3, -8);

for i in [Burlak, Petrovova, Titov, Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov] do
    begin
    ComMoveXY(i, 172, 219);
    AddComWait(i, rand(0$3, 0$4));
    AddComHold(i);
    end;

CenterOnUnits(Burlak);

if IsOk(Lipshchin) then
   begin
   ComMoveXY(Lipshchin, 175, 219);
   Say(Lipshchin, 'DStart-Lip-1');
   end
else if IsOk(Titov) then
   begin
   ComMoveXY(Titov, 175, 219);
   Say(Titov, 'DStart-Lip-1');
   end;

if IsOk(Karamazov) then
   begin
   ComMoveXY(Karamazov, 180, 225);
   Say(Karamazov, 'DStart-Kar-1');
   end;

for i in FilterUnitsInArea(southBaseArea, [f_side, 6]) do
    SetSide(i, 3);

for i in [Petrovova, Gleb, Dolgov, Petrosyan] do
    ComFree(i);

if IsOk(Karamazov) and GetClass(Karamazov) = class_engineer then
   ComMoveXY(Karamazov, 163, 209);

for i in UnitFilter([Titov, Dolgov, Karamazov], [[f_ok], [f_not, [f_class, class_engineer]]]) do
    begin
    ComEnterUnit(i, supplyBase);
    AddComChangeProfession(i, class_engineer);
    AddComExitBuilding(i);
    end;

AddComMoveXY(Petrosyan, 173, 220);

Say(Burlak, 'DStart-Bur-1');

wait(0$0.3);

SayRadio(Platonov, 'DStart-Pla-1');
Say(Burlak, 'DStart-Bur-2');

if IsOk(Petrovova) then
   begin
   ComTurnUnit(Petrovova, Burlak);

   Say(Petrovova, 'DStart-Ptr-2');
   end;

InGameOff;

ChangeMissionObjectives('MStart' & ['1', '2', '3', '3'][Difficulty]);

wait(0$3);

repeat
 wait(0$1);
until PlaceUnitXY(Jan, 172, 238, false);

ComMoveXY(Jan, 171, 219);
AddComMoveUnit(Jan, Burlak);

repeat
 wait(0$1);
until See(3, Jan) and See(6, Burlak);

wait(0$1);

DialogueOn;

CenterNowOnUnits(Jan);

Say(Burlak, 'DBur-Jan-1');
Say(Jan, 'DJan-1');
Say(Burlak, 'DBur-Jan-2');
Say(Jan, 'DJan-2');

wait(0$0.3);

RevealMapOnXY(130, 115, 3, -4);
CenterOnXY(130, 115);

Say(Jan, 'DJan-3');

wait(0$0.3);

RevealMapOnXY(57, 88, 3, -6);
CenterOnXY(57, 88);

Say(Jan, 'DJan-3a');

RevealMapOnXY(93, 87, 3, -4);
CenterOnXY(93, 87);

Say(Jan, 'DJan-3b');

CenterNowOnUnits(Jan);

Say(Burlak, 'DBur-Jan-3');

DialogueOff;

SetSide(Jan, 3);
End;

// capture ovsyenko
Every 0$2 trigger GetSide(ovsyenko) = 3 or not ovsyenkoSquad do
var i, tmp, d, time;
begin
hasOvsyenko := true;

tmp := FilterUnitsInArea(ovsyenkoBaseArea, [f_type, unit_building]);

for i in tmp do
    SetSide(i, 3);

CenterOnXY(128, 125);

DialogueOn;

if IsInArea(Karamazov, ovsyenkoBaseArea) then
   d := Say(Karamazov, 'DOvsyenkoTaken-Kar-1');

if not d and IsInArea(Titov, ovsyenkoBaseArea) then
   d := Say(Titov, 'DOvsyenkoTaken-Tit-1');

if d then
   if Say(Lipshchin, 'DOvsyenkoTaken-Lip-1') then
      Say(Gleb, 'DOvsyenkoTaken-Glb-1');

Say(Burlak, 'DOvsyenkoTaken-Bur-1');
SayRadio(Platonov, 'DOvsyenkoTaken-Pla-1');

DialogueOff;

ChangeMissionObjectives('MBuildMine');

SetTech(tech_sibDet, 3, state_enabled);
SetRestrict(b_siberite_mine, 3, state_enabled);

repeat
 wait(0$1);
until FilterUnitsInArea(ovsyenkoBaseArea, [[f_not, [f_constructed]], [f_nation, nation_russian], [f_btype, b_siberite_mine]]);

DSibMine;                

SetRestrict(b_lab_spacetime, 3, state_enabled);
SetRestrict(b_lab_siberium, 3, state_enabled);
SetRestrict(b_ext_siberium, 3, state_enabled);

SetTech(tech_sibPow, 3, state_enabled);
SetTech(tech_sibEng, 3, state_enabled);
SetTech(tech_tauField, 3, state_enabled);
SetTech(tech_ST1, 3, state_enabled);
SetTech(tech_sib1, 3, state_enabled);

ChangeMissionObjectives('MAddMine');

canSpawnVsevolod := true;
time := 3$0;

repeat
 wait(0$1);
 time := time - 0$1;

 if FilterAllUnits([[f_side, 3], [f_dist, terminal, 36]]) then
    time := 0$0;
until time <= 0$0;

SpawnVsevolod;
End;

Export function DVsevolod;
var d, belkovSaved;
begin
DialogueOn;

Say(Dolgov, 'DVsevolod-Dol-1');
SayRadio(Vsevolod, 'DVsevolod-Vse-1');
Say(Burlak, 'DVsevolod-Bur-1');
Say(Gleb, 'DVsevolod-Glb-1');
SayRadio(Vsevolod, 'DVsevolod-Vse-2');
Say(Burlak, 'DVsevolod-Bur-2');
SayRadio(Vsevolod, 'DVsevolod-Vse-3');
Say(Burlak, 'DVsevolod-Bur-3');
SayRadio(Vsevolod, 'DVsevolod-Vse-4');
Say(Burlak, 'DVsevolod-Bur-4');

d := Say(Gleb, 'DVsevolod-Glb-4');

if not d then
   d := Say(Karamazov, 'DVsevolod-RSol1-5');

if d then
   Say(Burlak, 'DVsevolod-Bur-5');

Say(Burlak, 'DVsevolod-Bur-6');
Say(Dolgov, 'DVsevolod-Dol-6');
Say(Burlak, 'DVsevolod-Bur-7');
SayRadio(Vsevolod, 'DVsevolod-Vse-7');

RevealMapOnXY(78, 37, 3, -14);

DialogueOff;

wait(0$3);

belkovSaved := LoadVariable('02_belkovSaved', false);

DialogueOn;

if not glebWarn then
   Say(Gleb, 'DHelp1-Glb-1');

if IsOk(Dolgov) and belkovSaved then
   d := Say(Dolgov, 'DHelp1-Dol-1')
else
   d := Say(Karamazov, 'DHelp1-RSol1-1');

if d then
   Say(Titov, 'DHelp1-Tit-1');

Say(Gleb, 'DHelp1-Glb-2');

if not belkovSaved then
   if not Say(Titov, 'DHelp2-Tit-1') then
      Say(Karamazov, 'DHelp2-RSol1-1');

d := Say(Gleb, 'DHelp2-Glb-1');

if not d then
   d := Say(Karamazov, 'DHelp2-RSol2-1');

if d then
   Say(Titov, 'DHelp2-Tit-2');

Say(Jan, 'DJan-4');
Say(Burlak, 'DHelp3-Bur-1');

if not Say(Lipshchin, 'DHelp3-Lip-1') then
   Say(Karamazov, 'DHelp3-RSol1-1');

Say(Burlak, 'DHelp3-Bur-2');

DialogueOff;

ChangeMissionObjectives('MVsevolod');

canGoToNorth := true;
End;

// block north area
Every 0$1 trigger not canGoToNorth and IsOk(Gleb) and FilterUnitsInArea(blockNorthArea, [f_side, 3]) do
begin
DialogueOn;   
Say(Gleb, 'DHelp1-Glb-1');
DialogueOff;

glebWarn := true;
End;

// block north area#2
Every 0$1 trigger not canGoToNorth and FilterUnitsInArea(blockNorthArea2, [f_side, 3]) do
PrepareAdditionalForces;

// talk about lab
Every 0$1 trigger FilterAllUnits([[f_side, 3], [f_not, [f_constructed]], [f_or, [f_btype, b_lab_full], [f_btype, b_lab_half], [f_btype, b_lab]]]) do
var sci;
begin
wait(1$00);

if not IsOk(Petrosyan) or GetClass(Petrosyan) <> class_scientistic then
   sci := Dolgov
else
   sci := Petrosyan;

if not IsOk(sci) then
   begin
   SetTech(tech_MatPred, 3, state_disabled);
   exit;
   end;

SetRestrict(b_lab_computer, 3, state_enabled);
SetTech(tech_MatPred, 3, state_enabled);

DialogueOn;

if sci = Petrosyan then
   begin
   Say(Petrosyan, 'DMatPrediction-Pty-1');
   Say(Burlak, 'DMatPrediction-Bur-1');
   Say(Petrosyan, 'DMatPrediction-Pty-2');
   Say(Burlak, 'DMatPrediction-Bur-2');
   Say(Petrosyan, 'DMatPrediction-Pty-3');
   end
else
   begin
   Say(Dolgov, 'DMatPrediction-Dol-1');
   Say(Burlak, 'DMatPrediction-Bur-1');
   Say(Dolgov, 'DMatPrediction-Dol-2');
   Say(Burlak, 'DMatPrediction-Bur-2');
   Say(Dolgov, 'DMatPrediction-Dol-3');
   end;

DialogueOff;

ChangeMissionObjectives('MPred');

repeat
 wait(0$1);
until GetTech(tech_MatPred, 3) = state_researched;

ChangeMissionObjectives('MOutPred');

SaveVariable(1, '06_MatPred');

hasMatPred := true;
noCrates := tick;

if not IsOk(Petrosyan) or GetClass(Petrosyan) <> class_scientistic then
   sci := Dolgov
else
   sci := Petrosyan;

if not IsOk(sci) then
   exit;

DialogueOn;

if sci = Petrosyan then
   begin
   Say(Petrosyan, 'DNoMaterial-Pty-1');
   Say(Burlak, 'DNoMaterial-Bur-1');
   Say(Petrosyan, 'DNoMaterial-Pty-2');
   Say(Burlak, 'DNoMaterial-Bur-2');
   end
else
   begin
   Say(Dolgov, 'DNoMaterial-Dol-1');
   Say(Burlak, 'DNoMaterial-Bur-1');
   Say(Dolgov, 'DNoMaterial-Dol-2');
   Say(Burlak, 'DNoMaterial-Bur-2');
   end;

DialogueOff;
End;

// has siberite mine
Function DSibMine;
var sci;
begin
if not IsOk(Petrosyan) or GetClass(Petrosyan) <> class_scientistic then
   sci := Dolgov
else
   sci := Petrosyan;

if not sci then
   begin
   if IsOk(Petrosyan) then
      sci := Petrosyan
   else
      exit;
   end;

DialogueOn;

if sci = Petrosyan then
   begin
   Say(Petrosyan, 'DSibResearch-Pty-1');
   end
else
   begin
   Say(Dolgov, 'DSibResearch-Dol-1');
   end;

Say(Burlak, 'DSibResearch-Bur-1');
SayRadio(Platonov, 'DSibResearch-Pla-1');

DialogueOff;
End;

// vsevolod killed by american before capture
Every 3 trigger vsevolodInTerminal and GetLives(Vsevolod) < 300 and not vsevolodCaptured do
var i;
begin
vsevolodDied := true;

DialogueOn;
SayRadio(Vsevolod, 'DDieVsev1-Vse-1');
DialogueOff;

CenterOnUnits(Vsevolod);

wait(0$0.3);

for i in [ [GetX(Vsevolod), GetY(Vsevolod)], [73,41], [81,33], [87,35], [75,49], [77,33]] do
    begin
    MineExplosion(i[1], i[2], 1);
    end;

SetLives(Vsevolod, 0);
End;

// spot with Vsevolod
Every 0$1 trigger vsevolodCaptured and not IsInUnit(Vsevolod) do
var un;
begin
wait(0$2);

americanAttackOvsyenko := true;

un := NearestUnitToUnit(
   UnitFilter([Burlak, Lipshchin, Dolgov, Petrosyan, Karamazov, Jan, Titov], [[f_inarea, terminalBaseArea], [f_ok]]),
   Vsevolod
);

if un = Burlak then
   begin
   DBurlakScene;
   exit;
   end;

DialogueOn;

Say(Vsevolod, 'DOtherMeetVsev-Vse-1');

if un = Jan then
   Say(Jan, 'DJan-6')
else
   Say(un, 'DOtherMeetVsev-RSol1-1');

DialogueOff;

repeat
 wait(0$1);
until GetDistUnits(Burlak, Vsevolod) < 8;

DBurlakScene;
End;

Export Function DBurlakScene;
var i, p, americanTransport;
begin
p := 0;
vsevolodTalkWithBurlak := true;

InGameOn;

if IsInUnit(Vsevolod) then
   ComExit(Vsevolod);

AddComMoveUnit(Vsevolod, Burlak);
ComMoveUnit(Burlak, Vsevolod);

repeat
 wait(0$1);
 p := Inc(p);
until GetDistUnits(Burlak, Vsevolod) < 5 or p > 8;

DialogueOn;

Say(Vsevolod, 'DMeetVsev-Vse-1');
Say(Burlak, 'DMeetVsev-Bur-1');

if not hasOvsyenko then
   begin
   Say(Vsevolod, 'DMeetVsev2-Vse-1');
   Say(Burlak, 'DMeetVsev2-Bur-1');
   Say(Vsevolod, 'DMeetVsev2-Vse-2');
   Say(Burlak, 'DMeetVsev3-Bur-1');
   end
else
   begin
   Say(Vsevolod, 'DMeetVsev2-Vse-2a');
   Say(Burlak, 'DMeetVsev2-Bur-2');
   Say(Vsevolod, 'DMeetVsev2-Vse-3');
   Say(Burlak, 'DMeetVsev3-Bur-1');
   end;

Say(Vsevolod, 'DMeetVsev3-Vse-1');
Say(Burlak, 'DMeetVsev3-Bur-2');
Say(Vsevolod, 'DMeetVsev3-Vse-2');

if stevensEscaped or stevensLeft or stevensKilled then
   begin
   Say(Burlak, 'DMeetVsev3-Bur-3');

   if stevensKilled then
      Say(Burlak, 'DMeetVsev4-Bur-1')
   else
      begin
      Say(Burlak, 'DMeetVsev5-Bur-1');
      Say(Vsevolod, 'DMeetVsev5-Vse-1');
      Say(Burlak, 'DMeetVsev5-Bur-2');
      end;

   Say(Vsevolod, 'DMeetVsev6-Vse-1');
   Say(Burlak, 'DMeetVsev6-Bur-1');
   end;

DialogueOff; 
InGameOff;

wait(0$20);

americanTransport := PowellTransport;

SetDir(americanTransport[3], 3);
SetDir(americanTransport[4], 3);

repeat
 wait(0$1);
until PlaceUnitXY(americanTransport[3], 50, 3, false);

SetCargo(americanTransport[3], mat_cans, 100);

PlaceHumanInUnit(americanTransport[1], americanTransport[3]);

ComMoveXY(americanTransport[1], 73, 36);

repeat
 wait(0$1);
until PlaceUnitXY(americanTransport[4], 50, 3, false);

SetCargo(americanTransport[4], mat_cans, 100);

PlaceHumanInUnit(americanTransport[2], americanTransport[4]);

ComMoveXY(americanTransport[2], 73, 36);

repeat
 wait(0$1);
until UnitFilter(americanTransport, [f_see, 3]);

wait(0$5);

DialogueOn;

Say(americanTransport[2], 'DTruck-Sol1-1');
Say(Burlak, 'DTruck-Bur-1');

DialogueOff;

wait(0$1);

ComUnload(americanTransport);

wait(0$0.3);

AddComMoveXY(americanTransport, 50, 2);

repeat
 wait(0$1);

 for i in americanTransport do
     begin
     if IsDead(i) or GetSide(i) = 3 then
        begin
        americanTransport := americanTransport diff i;
        continue;
        end;

     ComMoveXY(i, 50, 2);

     if IsInArea(i, vsevolodSpawnArea) and IsOk(i) then
        begin
        RemoveUnit(i);
        americanTransport := americanTransport diff i;
        end;
     end;
until not americanTransport;
End;

Every 3 trigger vsevolodCaptured and GetLives(Vsevolod) < 10 and GetDistUnits(Vsevolod, Burlak) > 20 do
begin
DialogueOn;
ForceSay(Vsevolod, 'DDieVsev2-Vse-1');
DialogueOff;

SetLives(Vsevolod, 0);
End;

// trap
Every 0$1 trigger vsevolodInTerminal and not isInTrap and not vsevolodCaptured do
var i, tmp, un, isWest, isEast, skill;
begin
repeat
 wait(0$1);
 isWest := FilterUnitsInArea(trapWestArea, [f_side, 3]) > 0;
 isEast := FilterUnitsInArea(trapEastArea, [f_side, 3]) > 0;
until isWest or isEast or vsevolodCaptured;

if vsevolodCaptured then
   exit;

isInTrap := true;

skill := [3, 4, 5, 6][Difficulty];
tmp := [];

if isWest then
   begin
   for i := 1 to [3, 3, 4, 5][Difficulty] do
       begin
       uc_side := 1;
       uc_nation := nation_american;

       PrepareSoldier(false, skill);

       un := CreateHuman;
       Push(tmp, un);

       PlaceUnitArea(un, trapWestSpawnArea, false);

       ComAgressiveMove(un, 110, 66);
       end;
   end
else
   begin
   for i := 1 to [3, 3, 4, 5][Difficulty] do
       begin
       uc_side := 1;
       uc_nation := nation_american;

       PrepareSoldier(false, skill);

       un := CreateHuman;
       Push(tmp, un);

       PlaceUnitArea(un, trapEastSpawnArea, false);

       ComAgressiveMove(un, 139, 88);
       end;
   end;

wait(0$2);

DialogueOn;

Say(Karamazov, 'DPartyAttacked-RSol1-1');
Say(Gleb, 'DPartyAttacked-Glb-1');
Say(Lipshchin, 'DPartyAttacked-RSol2-1');

DialogueOff;

repeat
 wait(0$1);

 for i in tmp do
     begin
     if IsDead(i) then
        begin
        tmp := tmp diff i;
        continue;
        end;

     if not HasTask(i) then
        ComAgressiveMove(i, 130, 123);
     end;
until not tmp;
End;

// american captured ovsyenko again
Every 0$1 trigger hasOvsyenko and GetSide(ovsyenko) = 1 do
begin
CenterOnUnits(ovsyenko);

DialogueOn;

if IsOk(Gleb) then
   begin
   Say(Gleb, 'DOvsyenkoCaptured-Glb-1');
   Say(Burlak, 'DOvsyenkoCaptured-Bur-1');
   end
else if IsOk(Karamazov) then
   Say(Karamazov, 'DOvsyenkoCaptured-RSol1-1')
else if IsOk(Lipshchin) then
   Say(Lipshchin, 'DOvsyenkoCaptured-RSol1-1')
else if IsOk(Titov) then
   Say(Titov, 'DOvsyenkoCaptured-RSol1-1');

if IsOk(Jan) then
   Say(Jan, 'DJan-5');

DialogueOff;

ChangeMissionObjectives('MRecapture');

hasOvsyenko := false;

repeat
 wait(0$1);
until GetSide(ovsyenko) = 3;

hasOvsyenko := true;

ChangeMissionObjectives('MOutRecapture');
End;

// research time stasi
Every 0$1 trigger GetTech(tech_TauField, 3) = state_researched do
var sci;
begin
if GetClass(Petrosyan) = 4 and IsOk(Petrosyan) then
   begin
   DialogueOn;

   Say(Petrosyan, 'DStasis-Pty-1');
   Say(Burlak, 'DStasis-Bur-1');
   Say(Petrosyan, 'DStasis-Pty-2');
   Say(Burlak, 'DStasis-Bur-2');

   DialogueOff;
   end
else if GetClass(Dolgov) = 4 and IsOk(Dolgov) then
   begin
   DialogueOn;

   Say(Dolgov, 'DStasis-Dol-1');
   Say(Burlak, 'DStasis-Bur-1');
   Say(Dolgov, 'DStasis-Dol-2');
   Say(Burlak, 'DStasis-Bur-2');


   DialogueOff;
   end
else
   begin
   sci := UnitFilter([], [f_class, 4]);

   if not sci then
      exit;

   DialogueOn;

   Say(sci[1], 'DStasis-RSol1-1');
   Say(Burlak, 'DStasis-Bur-1');
   Say(Dolgov, 'DStasis-RSol1-2');
   Say(Burlak, 'DStasis-Bur-2');

   DialogueOff;
   end;
End;

// lose
Every 0$1 trigger GetSideSib(1) + GetSideSib(4) >= americanSibToCollect do
begin
YouLost('SibL');
End;

// can end
Every 0$1 trigger GetSideSib(3) >= 200 and hasAllTechs do
var i, j, hasVsevolod, tmp, min, max, buildings, depot, arm, lab, fac, kirBel;
begin
canEnd := true;
hasVsevolod := GetSide(Vsevolod) = 3 and not vsevolodDied;

ChangeMissionObjectives('MOutMine');

DialogueOn;

SayRadio(Platonov, 'DNextMiss1-Pla-1');
SayRadio(Platonov, 'DNextMiss2-Pla-1');

if hasVsevolod then
   begin
   SayRadio(Platonov, 'DNextMiss3-Pla-1');
   SayRadio(Platonov, 'DNextMiss3-Pla-1a');
   end;

Say(Burlak, 'DNextMiss4-Bur-1');

DialogueOff;

ChangeMissionObjectives('MCars');
SetAreaMapShow(eastEndArea, 1);
ChangeSideFog(6, 3);

if hasVsevolod then
   begin
   tmp := FilterAllUnits([[f_side, 3], [f_type,unit_human], [f_nation, nation_russian]]) diff [Vsevolod, Burlak];

   max := tmp div 2 + tmp mod 2;
   min := 0;

   if max > 1 then
      begin
      stay := [Burlak] union
          CharacterSelection(
                  '1',
                  min,
                  max,
                  [Burlak, sel_changeable, sel_change_class]
                  ^ (tmp diff vsevolodSquad)
                  ^ [sel_not_hired]
                  ^ vsevolodSquad
                  ^ [sel_not_changeable, Vsevolod],
                  [class_soldier, class_engineer, class_mechanic, class_scientistic]
          );
      goOut := [Vsevolod] union (tmp diff stay);
      end
   else
      begin
      stay := [Burlak];
      goOut := [Vsevolod] union tmp;
      end;

   if goOut then
      begin
      for i in goOut do
          begin
          SetSide(i, 6);
          SetInvulnrability(i, 6);
          end;

      repeat
       wait(0$1);

       for i in goOut do
           begin
           if IsAt(i, 147, 66) then
              begin
              RemoveUnit(i);
              continue;
              end;

           if IsInUnit(i) then
              ComExit(i)
           else
              ComAgressiveMove(i, 147, 66);
           end;
      until not UnitFilter(goOut, [f_ok]);
      end;
   end;

PrepareYakotich;

if Kirilenkova or Belkov then
   begin
   kirBel := UnitFilter([Kirilenkova, Belkov], [f_ok]);
   yakotichSquad := yakotichSquad diff kirBel;
   end;

wait(0$10);

ComExitVehicle(Yakotich);

repeat
 wait(3);
until not IsInUnit(Yakotich);

CenterOnXY(187, 216);

DialogueOn;
SayRadio(Yakotich, 'DYakot-1');
DialogueOff;

buildings := FilterUnitsInArea(southBaseExtArea, [[f_side, 3], [f_type, unit_building]]);

for i in buildings do
    begin
    SetSide(i, 6);

    tmp := UnitsInside(i);

    if tmp then
       for j in tmp do
           ComExitBuilding(j);
    end;

depot := UnitFilter(buildings, [f_or, [f_btype, b_depot], [f_btype, b_warehouse]]);
arm := UnitFilter(buildings, [f_or, [f_btype, b_armoury], [f_btype, b_barracks]]);
fac := UnitFilter(buildings, [f_or, [f_btype, b_workshop], [f_btype, b_factory]]);
lab := UnitFilter(buildings, [f_or, [f_btype, b_lab], [f_btype, b_lab_full], [f_btype, b_lab_half]]);

for i in Yakotich union yakotichSquad do
    begin
    ComExitVehicle(i);

    wait(3);

    AddComMoveXY(i, 171, 217);

    if (GetClass(i) = 2 or i = Yakotich) and depot then
       AddComEnterUnit(Yakotich, depot[1]);

    if GetClass(i) = 3 and fac then
       AddComEnterUnit(i, fac[1]);

    if GetClass(i) = 1 and arm and i <> Yakotich then
       AddComEnterUnit(i, arm[1]);

    if GetClass(i) = 4 and lab then
       AddComEnterUnit(i, lab[1]);

    wait(0$1);
    end;

if kirBel then
   begin
   for i in kirBel do
       begin
       ComExitVehicle(i);

       wait(3);

       if GetDistUnits(i, Burlak) < GetDistUnits(i, ovsyenko) then
          AddComMoveUnit(i, Burlak)
       else
          begin
          AddComMoveXY(i, 149, 157);
          AddComMoveXY(i, 129, 125);
          AddComMoveXY(i, 126, 122);
          end;
       end;

   repeat
    wait(0$1);

    if UnitFilter(kirBel, [f_alive]) = 0 then
       exit;

    for i in UnitFilter(kirBel, [f_not, [f_hastask]]) do
        begin
        ComMoveXY(i, 149, 157);
        AddComMoveXY(i, 129, 125);
        AddComMoveXY(i, 126, 122);
        end;

   until GetDistUnits(kirBel[1], Burlak) < 8 or GetDistUnits(kirBel[1], ovsyenko) < 10;

   for i in kirBel do
       begin
       ComStop(i);
       SetSide(i, 3);
       end;

   if Kirilenkova then
      begin
      DialogueOn;
      CenterNowOnUnits(Kirilenkova);

      if Belkov then
         Say(Belkov, 'D10-Bel-1');

      Say(Kirilenkova, 'D10-Kir-1');

      DialogueOff;
      end
   else
      begin
      DialogueOn;
      CenterNowOnUnits(Belkov);
      Say(Belkov, 'D10-Bel-1'); 
      DialogueOff;
      end;
   end;

for i in UnitFilter(yakotichSquad, [f_outside]) do
    begin
    ComMoveXY(i, 171, 217);

    if (GetClass(i) = 2 or i = Yakotich) and depot then
       AddComEnterUnit(Yakotich, depot[1]);

    if GetClass(i) = 3 and fac then
       AddComEnterUnit(i, fac[1]);

    if GetClass(i) = 1 and i <> Yakotich and arm then
       AddComEnterUnit(i, arm[1]);

    if GetClass(i) = 4 and lab then
       AddComEnterUnit(i, lab[1]);
    end;
End;

Every 0$1 trigger Researched(3, tech_TauField) and Researched(3, tech_ST1) and Researched(3, tech_Sib1) and Researched(3, tech_SibEng) do
begin
ChangeMissionObjectives('MOutTech');
hasAllTechs := true;
End;

// Finish
Every 0$1 trigger canEnd and FilterUnitsInArea(eastEndArea, [f_side, 3]) and (IsInArea(Burlak, eastEndArea) or IsDriverInArea(Burlak, eastEndArea)) do
begin
if FilterUnitsExceptArea(eastEndArea, [[f_side, 3], [f_type, unit_human]]) and
   (IsInArea(Burlak, eastEndArea) or IsDriverInArea(Burlak, eastEndArea)) then
   begin
   if Query('QEndGame') = 1 then
      begin
      FinishMission;
      exit;
      end;
   end;

repeat
 wait(0$1);
until FilterUnitsExceptArea(eastEndArea, [[f_side, 3], [f_type, unit_human]]) = 0 and
      FilterUnitsExceptArea(eastEndArea, [[f_side, 3], [f_type, unit_vehicle], [f_not, [f_empty]]]) = 0;

FinishMission;
End;

Function FinishMission;
var i, saveVehicles;
begin
if vsevolodCaptured and not vsevolodDied then
   AddMedal('Vsevolod', 1)
else
   AddMedal('Vsevolod', -1);

if hasOvsyenko then
   AddMedal('Ovsyenko', 1)
else
   AddMedal('Ovsyenko', -1);

if hasMatPred then
   AddMedal('Prediction', 1)
else
   AddMedal('Prediction', -1);

GiveMedals('Exit');

RewardPeople(FilterAllUnits([[f_side, 3], [f_type, unit_human], [f_nation, nation_russian]]));

// Burlak, Petrovova, Titov, Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov, Jan;
SaveCharacters(Burlak, currentMissionPrefix & 'Burlak');

if IsLive(Karamazov) and Karamazov in stay then
   SaveCharacters(Karamazov, currentMissionPrefix & 'Karamazov')
else if Karamazov in goOut then
   SaveCharacters(Karamazov, currentMissionPrefix & 'Vse_Karamazov');

if IsLive(Petrovova) and Petrovova in stay then
   SaveCharacters(Petrovova, currentMissionPrefix & 'Petrovova')
else if Petrovova in goOut then
   SaveCharacters(Petrovova, currentMissionPrefix & 'Vse_Petrovova');

if IsLive(Titov) and Titov in stay then
   SaveCharacters(Titov, currentMissionPrefix & 'Titov')
else if Titov in goOut then
   SaveCharacters(Titov, currentMissionPrefix & 'Vse_Titov');

if IsLive(Lipshchin) and Lipshchin in stay then
   SaveCharacters(Lipshchin, currentMissionPrefix & 'Lipshchin')
else if Lipshchin in goOut then
   SaveCharacters(Lipshchin, currentMissionPrefix & 'Vse_Lipshchin');

if IsLive(Gleb) and Gleb in stay then
   SaveCharacters(Gleb, currentMissionPrefix & 'Gleb')
 else if Gleb in goOut then
   SaveCharacters(Gleb, currentMissionPrefix & 'Vse_Gleb');

if IsLive(Dolgov) and Dolgov in stay then
   SaveCharacters(Dolgov, currentMissionPrefix & 'Dolgov')
else if Dolgov in goOut then
   SaveCharacters(Dolgov, currentMissionPrefix & 'Vse_Dolgov');

if IsLive(Petrosyan) and Petrosyan then
   SaveCharacters(Petrosyan, currentMissionPrefix & 'Petrosyan')
else if Petrosyan in goOut then
   SaveCharacters(Petrosyan, currentMissionPrefix & 'Vse_Petrosyan');

if IsLive(Jan) and Jan in stay then
   SaveCharacters(Jan, currentMissionPrefix & 'Jan')
else if Jan in goOut then
   SaveCharacters(Jan, currentMissionPrefix & 'Vse_Jan');

if IsLive(Belkov) then
   SaveCharacters(Belkov, currentMissionPrefix & 'Belkov');

if IsLive(Kirilenkova) then
   SaveCharacters(Kirilenkova, currentMissionPrefix & 'Kirilenkova');

SaveTech(3, currentMissionPrefix & 'Techs');

SaveCharacters(UnitFilter(stay, [f_ok]) diff [Burlak, Petrovova, Titov, Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov, Jan], currentMissionPrefix & 'burlakTeam');

if not vsevolodDied then
   begin
   SaveCharacters(Vsevolod, currentMissionPrefix & 'Vsevolod');
   SaveVariable(true, '06_VsevolodSaved');

   if goOut then
      SaveCharacters(goOut diff [Burlak, Petrovova, Titov, Lipshchin, Gleb, Dolgov, Petrosyan, Karamazov, Jan], currentMissionPrefix & 'vsevolodTeam');
   end;

if IsOk(Yakotich) then
   SaveCharacters(Yakotich, currentMissionPrefix & 'Yakotich');

saveVehicles := [];

for i in FilterUnitsInArea(eastEndArea, [[f_side, 3], [f_type, unit_vehicle], [f_not, [f_empty]], [f_ok]]) do
    saveVehicles := Join(saveVehicles, [GetChassis(i), GetEngine(i), GetControl(i), GetWeapon(i), GetNation(i), [GetCargo(i, mat_cans), GetCargo(i, mat_oil), GetCargo(i, mat_siberit), GetMark(i)]]);

if saveVehicles then
   SaveVariable(saveVehicles, currentMissionPrefix & 'Vehicles');

YouWin;
End;