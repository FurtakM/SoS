Every 4$40 + 3$20 trigger GetResourceArea(cratesForestArea, mat_cans) < 30 do
begin
enable;

if noCrates + 5$00 > tick then
   exit;

CreateCratesArea(rand(1, 5), cratesForestArea, true);
End;

Every 3$40 trigger GetResourceArea(cratesAmericanArea, mat_cans) < 7 do
begin
enable;

if noCrates + 5$00 > tick then
   exit;

CreateCratesArea(rand(1, 5), cratesAmericanArea, true);
CreateCratesArea(rand(1, 5), cratesAmericanArea, true);
End;

Every 0$55 trigger GetResourceArea(cratesSouthArea, mat_cans) < 14 and tick < [22$0, 20$0, 18$0, 16$0][Difficulty] do
begin
enable;

if noCrates + 5$00 > tick then
   exit;

CreateCratesArea(rand(1, 5), cratesSouthArea, true);
End;

Every 0$50 + 0$10 trigger tick < 6$30 and not noCrates do
begin
enable;
CreateCratesXYR(rand(2, 5), 168, 216, 12, true);
End;