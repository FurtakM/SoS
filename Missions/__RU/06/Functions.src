Export Function GetSideSib(side);
var i, tmp;
begin
result := 0;

tmp := FilterAllUnits([[f_side, side], [f_or, [f_btype, b_depot], [f_btype, b_warehouse]]]);

if not tmp then
   exit;

for i in tmp do
    result := result + GetResourceType(GetBase(i), mat_siberit);
End;

Export Function PlaceBuilding(btype, level, x, y, d, weapon);
begin
InitBc;

if btype = b_lab then
   begin
   bc_kind1 := b_lab_basic;
   bc_kind2 := b_lab_basic;
   end;

bc_level := level;
bc_type := btype;
result := CreateAndPlaceBuildingXYD(x, y, d);

if btype in [b_bunker, b_turret] then
   PlaceWeaponTurret(result, weapon);
End;

Export Function RemoveUnitFromHex(x, y);
begin
result := HexInfo(x, y);

if not result then
   exit;

RemoveUnit(result);
End;