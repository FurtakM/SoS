Export Sikorski, VanHouten, Grant, usCargoTransport;
Export ovsyenkoSquad, americanSquad, terminalSquad;
Export americanVehicles, americanAttackVehicles, americanTechs, americanBuildingsToBuild, americanConstructList, americanAttackVehiclesTmp;
Export function PrepareAmerican;
var i, un;
begin
ovsyenkoSquad := [];
americanSquad := [];
terminalSquad := [];

americanVehicles := [];
americanAttackVehiclesTmp := [];
americanAttackVehicles := [];
americanTechs := GetTechNation(1, nation_american, state_enabled);
americanBuildingsToBuild := [];
americanConstructList := [
   [us_heavy_tracked, engine_combustion, control_remote, us_bulldozer],
   [us_medium_tracked, engine_combustion, control_remote, us_crane],
   [us_medium_tracked, engine_combustion, control_remote, us_crane]
];

SetBName(usBase, 'tau');
SetBName(ovsyenko, 'ovsyenko');
SetBName(terminal, 'terminal');

AddResourceType(GetBase(terminal), mat_cans, 600 - (100 * Difficulty) + 30);
AddResourceType(GetBase(usBase), mat_cans, 2500);
AddResourceType(GetBase(usBase), mat_oil, 200);
AddResourceType(GetBase(ovsyenko), mat_cans, 150);

SetResourceVisibility(136, 123, 4);
SetResourceVisibility(136, 123, 1);
SetResourceVisibility(92, 86, 1);

uc_side := 1;
uc_nation := nation_american;

if Difficulty >= 3 then
   begin
   RemoveEnvironmentArea(clearForestArea);
   PlaceBuilding(b_breastwork, [3, 4, 5, 5][Difficulty], 47, 39, 4, 0);
   end;

americanSquad := PrepareAmericanSquad;

if LoadVariable('03_SikorskiAlive', true) then
   begin
   Sikorski := NewCharacter('Sikorski');
   PlaceUnitXY(Sikorski, 58, 64, false);

   Push(americanSquad, Sikorski);
   end
else
   begin
   VanHouten := NewCharacter('VanHouten');
   PlaceUnitXY(VanHouten, 58, 64, false);

   Push(americanSquad, VanHouten);
   end;

for i in FilterAllUnits([[f_side, 1], [f_type, unit_building]]) do
    SetBLevel(i, 4 + Difficulty);

if not debugCapture then
   ovsyenkoSquad := PrepareOvsyenko
else
   begin
   for i in FilterAllUnits([[f_side, 4], [f_type, unit_building]]) do
       SetSide(i, 3);
   end;

terminalSquad := PrepareTerminal;

for i in FilterAllUnits([[f_side, 1], [f_btype, b_breastwork], [f_empty]]) do
    begin
    PrepareSoldier(false, [4, 5, 6, 6][Difficulty]);
    un := CreateHuman;
    SetDir(un, GetDir(i) - 3);
    PlaceHumanInUnit(un, i);
    end;

PrepareVehicle(us_medium_tracked, engine_combustion, control_manual, us_cargo_bay, 100);
usCargoTransport := CreateVehicle;

PlaceUnitXYD(usCargoTransport, 55, 74, 3, false);

PrepareEngineer(false, 3);
PlaceHumanInUnit(CreateHuman, usCargoTransport);
End;

Function PrepareTerminal;
var i, un, tmp, tmp2, tmp3, veh, skill;
begin
uc_side := 1;

tmp := FilterUnitsInArea(terminalBaseArea, [f_type, unit_building]) diff terminal;

for i in tmp do
    ComLinkToBase(terminal, i);

skill := 4;

tmp := FilterUnitsInArea(terminalBaseArea, [f_or, [f_btype, b_breastwork], [f_btype, b_bunker]]);
tmp2 := FilterUnitsInArea(terminalBaseArea, [f_or, [f_btype, b_armoury], [f_btype, b_barracks]]);

for i := 1 to 5 do
    begin
    PrepareSoldier(false, skill);
    un := CreateHuman;

    Push(result, un);

    tmp3 := UnitFilter(tmp, [f_empty]);

    if tmp3 then
       begin
       SetDir(un, GetDir(tmp3[1]) - 3);
       PlaceHumanInUnit(un, tmp3[1]);
       continue;
       end;

    tmp3 := UnitFilter(tmp2, [f_not, [f_full]]);

    if tmp3 then
       begin
       PlaceHumanInUnit(un, tmp3[1]);
       continue;
       end;

    PlaceUnitXYR(un, 80, 39, 5, false);
    end;

PrepareEngineer(false, skill);
un := CreateHuman;

Push(result, un);

PlaceUnitXYR(un, 79, 39, 5, false);
End;

Function PrepareAmericanSquad;
var i, un, tmp, tmp2, tmp3, veh, skill;
begin
uc_side := 1;

skill := [4, 5, 5, 6][Difficulty];

tmp := FilterUnitsInArea(americanBaseArea, [f_or, [f_btype, b_breastwork], [f_btype, b_bunker]]);
tmp2 := FilterUnitsInArea(americanBaseArea, [f_or, [f_btype, b_armoury], [f_btype, b_barracks]]);

for i := 1 to [6, 7, 8, 9][Difficulty] do
    begin
    PrepareSoldier(false, skill);
    un := CreateHuman;

    Push(result, un);

    tmp3 := UnitFilter(tmp, [f_empty]);

    if tmp3 then
       begin
       SetDir(un, GetDir(tmp3[1]) - 3);
       PlaceHumanInUnit(un, tmp3[1]);
       continue;
       end;

    tmp3 := UnitFilter(tmp2, [f_not, [f_full]]);

    if tmp3 then
       begin
       PlaceHumanInUnit(un, tmp3[1]);
       continue;
       end;

    PlaceUnitXYR(un, 55, 70, 5, false);
    end;

for i := 1 to 3 do
    begin
    PrepareEngineer(false, skill);
    un := CreateHuman;

    Push(result, un);

    PlaceUnitXYR(un, 55, 70, 5, false);
    end;

for i := 1 to 4 do
    begin
    PrepareMechanic(false, skill);
    un := CreateHuman;

    Push(result, un);

    PlaceHumanInUnit(un, usFac);
    end;

PrepareMechanic(false, skill + 2);
un := CreateHuman;

Push(result, un);

PlaceHumanInUnit(un, usCt);

for i := 1 to 3 do
    begin
    PrepareScientist(false, skill);
    un := CreateHuman;

    Push(result, un);

    PlaceHumanInUnit(un, usLab);
    end;
End;

Function PrepareOvsyenko;
var i, tmp, list, blevel, people, cleanTrees, x, y, d, btype, weapon, un, buildings;
begin
uc_side := 4;

Grant := NewCharacter('Gary');
PlaceHumanInUnit(Grant, ovsyenko);
Push(result, Grant);

blevel := [3, 4, 5, 6][Difficulty];
cleanTrees := false;

SetResourceVisibility(122, 114, 4);

// normal squad
if timeToOvsyenkoFall > (prevMissionTime + penaltyTime) then
   begin
   // oil and armoury, a few soldiers
   list := [
      [b_oil_mine, 122, 114, 0],
      [b_armoury, 128, 131, 0]
   ];
   people := [4, 1];
   end
else if (timeToOvsyenkoFall + 10$00) > (prevMissionTime + penaltyTime) then  // stronger squad
   begin
   // oil, armoury, oil plant, one tower, a few soldiers, engineers
   list := [
      [b_oil_mine, 122, 114, 0],
      [b_armoury, 128, 131, 0],
      [b_oil_power, 125, 116, 5],
      [b_bunker, 135, 133, 5, us_double_gun]
   ];
   people := [[4, 4, 5, 5][Difficulty], 2];
   end
else if (timeToOvsyenkoFall + 20$00) > (prevMissionTime + penaltyTime) then  // stronger squad x2
   begin
   // oil, armoury, oil plant, two towers, a few soldiers, engineers
   list := [
      [b_oil_mine, 122, 114, 0],
      [b_armoury, 128, 131, 0],
      [b_oil_power, 125, 116, 5],
      [b_bunker, 135, 133, 5, us_double_gun],
      [b_bunker, 129, 114, 4, [us_machine_gun, us_machine_gun, us_gatling_gun, us_gatling_gun][Difficulty]],
   ];
   people := [[4, 5, 6, 6][Difficulty], 2];
   end
else // stronger squad x3
   begin
   // oil, barracks, oil plant, four towers, more soldiers, engineers, no trees, lab
   list := [
      [b_oil_mine, 122, 114, 0],
      [b_barracks, 128, 131, 0],
      [b_oil_power, 125, 116, 5],
      [b_bunker, 135, 133, 5, us_double_gun],
      [b_bunker, 129, 114, 4, [us_machine_gun, us_machine_gun, us_gatling_gun, us_gatling_gun][Difficulty]],
      [b_bunker, 120, 121, 1, us_double_gun],
      [b_bunker, 123, 127, 1, us_gatling_gun],
      [b_lab, 134, 126, 5]
   ];
   people := [[5, 5, 6, 6][Difficulty], 2];
   cleanTrees := true;
   end;

if cleanTrees then
   begin
   RemoveEnvironmentArea(ovsyenkoEnvBaseArea);
   RemoveEnvironmentArea(ovsyenkoEnvBaseArea);
   end;

for i in list do
    begin
    btype := i[1];
    x := i[2];
    y := i[3];
    d := i[4];
    weapon := 0;

    if Count(i) = 5 then
       weapon := i[5];

    RemoveUnitFromHex(x, y);

    Push(buildings, PlaceBuilding(btype, [3, 4, 5, 5][Difficulty], x, y, d, weapon));
    end;

buildings := buildings union FilterUnitsInArea(ovsyenkoBaseArea, [[f_side, 4], [f_type, unit_building]]);

for i := 1 to people[1] do
    begin
    PrepareSoldier(false, [4, 5, 5, 6][Difficulty]);
    un := CreateHuman;
    Push(result, un);

    tmp := UnitFilter(buildings, [[f_empty], [f_or, [f_btype, b_breastwork], [f_btype, b_bunker]]]);

    if tmp then
       begin
       SetDir(un, GetDir(tmp[1]) - 3);
       PlaceHumanInUnit(un, tmp[1]);
       continue;
       end;

    tmp := UnitFilter(buildings, [[f_not, [f_full]], [f_or, [f_btype, b_armoury], [f_btype, b_barracks]]]);

    if tmp then
       begin
       PlaceHumanInUnit(un, tmp[1]);
       continue;
       end;

    PlaceUnitXYR(un, 128, 123, 5, false);
    end;

for i := 1 to people[2] do
    begin
    PrepareEngineer(false, [4, 5, 5, 6][Difficulty] - 1);
    un := CreateHuman;
    Push(result, un);

    PlaceHumanInUnit(un, ovsyenko);
    end;

PrepareScientist(false, 3);
un := CreateHuman;
Push(result, un);

PlaceHumanInUnit(un, ovsyenko);
End;

Export Function PowellTransport;
var i;
begin
uc_side := 4;
uc_nation := 1;

// prepare mechs
PrepareHuman(sex_male, 3, 6);
hc_name := 'Augustin Higgins';
hc_skills := [2, 1, 7, 4];
hc_gallery := 'SecondCharsGal';
hc_face_number := 30;

Push(result, CreateHuman);

hc_name := 'Fred Hashimoto';
hc_skills := [3, 2, 5, 1];
hc_face_number := 31;

Push(result, CreateHuman);

for i := 1 to 2 do
    begin
    PrepareVehicle(us_medium_tracked, engine_combustion, control_manual, us_cargo_bay, 66);
    Push(result, CreateVehicle);
    end;
End;

Export Function PrepareAdditionalForces;
var i, un, veh;
begin
for i := 1 to 6 do
    begin
    uc_side := 1;
    uc_nation := nation_american;

    PrepareSoldier(false, [4, 5, 6, 6][Difficulty]);
    un := CreateHuman;

    SetDir(un, 4);

    repeat
     wait(0$1);
    until PlaceUnitArea(un, eastSpawnArea, false);

    Push(result, un);

    ComMoveXY(un, 141, 70);
    end;

for i := 1 to 2 do
    begin
    uc_side := 1;
    uc_nation := nation_american;

    PrepareVehicle(us_medium_tracked, engine_solar, control_manual, us_gatling_gun, 100);
    veh := CreateVehicle;

    SetDir(un, 4);

    repeat
     wait(0$1);
    until PlaceUnitArea(veh, eastSpawnArea, false);

    Push(result, veh);

    PrepareMechanic(false, [4, 5, 6, 7][Difficulty]);
    un := CreateHuman;

    SetTag(un, tEscape);

    PlaceHumanInUnit(un, veh);
    end;

repeat
 wait(0$1);

 for i in UnitFilter(result, [f_ok]) do
     begin
     AgressiveMove(i, [[138, 92], [149,116], [136,116]]);
     end;
until not UnitFilter(result, [f_ok]);
End;

// American Scripts
// Ovsyenko Script
Every 0$3 + 0$2 trigger FilterUnitsInArea(ovsyenkoBaseArea, [f_side, 3]) and not IsOk(Grant) do
begin
if not HexInfo(136, 123) then
   exit;

MineExplosion(135, 120, 1);
MineExplosion(135, 122, 1);
End;

Every 0$1 + 0$3 trigger ovsyenkoSquad do
var i, tmp, buildings, class, empty, enemyInBase, damaged, hurts;
begin
enable;

tmp := UnitFilter(ovsyenkoSquad, [f_ok]);
buildings := FilterUnitsInArea(ovsyenkoBaseArea, [f_type, unit_building]);
enemyInBase := FilterUnitsInArea(ovsyenkoBaseArea, [f_side, 3]);
damaged := UnitFilter(buildings, [[f_not, [f_btype, b_siberite_mine]],  [f_not, [f_lives, 1000]]]);
hurts := UnitFilter(ovsyenkoSquad, [[f_not, [f_class, 4]], [f_not, [f_inside]], [f_not, [f_lives, 1000]]]);

if not tmp then
   exit;

for i in tmp do
    begin
    class := GetClass(i);

    if class = class_scientistic then
       begin
       if hurts then
          begin
          if IsInUnit(i) then
             ComExitBuilding(i)
          else
             ComHeal(i, SortByHealth(hurts, true));
          end
       else
          if not IsInUnit(i) then
             ComEnterUnit(i, ovsyenko);
       end;

    if class = class_engineer then
       begin
       if GetLives(i) > 600 then
          begin
          if damaged then
             begin
             if IsInUnit(i) then
                ComExitBuilding(i)
             else
                ComRepairBuilding(i, NearestUnitToUnit(damaged, i));
             end
          else
             begin
             if not IsInUnit(i) then
                if not HexInfo(136, 123) then
                   ComBuild(i, b_siberite_mine, 136, 123, 0)
                else if not HasTask(i) then
                   ComEnterUnit(i, ovsyenko);
             end;
          end
       else
          if GetDistUnitXY(i, 126, 122) > 3 then
             ComMoveXY(i, 126, 122)
          else
             ComHold(i);
       end;

    if class = class_soldier then
       begin
       if enemyInBase then
          begin
          if GetLives(i) > 600 then
             begin
             if IsInUnit(i) and not See(3, IsInUnit(i)) then
                ComExitBuilding(i)
             else
                ComAttackUnit(i, NearestUnitToUnit(enemyInBase, i));
             end
          else
             begin
             if not IsInUnit(i) then
                begin
                empty := UnitFilter(buildings, [[f_not, [f_full]], [f_or, [f_btype, b_bunker],
                                                                          [f_btype, b_breastwork],
                                                                          [f_btype, b_armoury],
                                                                          [f_btype, b_barracks]]]);
                if empty then
                   ComEnterUnit(i, NearestUnitToUnit(empty, i));
                end;
             end;
          end
       else
          begin
          if GetLives(i) < 1000 then
             begin
             if IsInUnit(i) then
                ComExitBuilding(i)
             else
                if GetDistUnitXY(i, 126, 122) > 3 then
                   ComMoveXY(i, 126, 122);
             end
          else
             begin
             if not IsInUnit(i) or (not IsInUnit(i) and not IsInArea(i, ovsyenkoBaseArea)) then
                begin
                empty := UnitFilter(buildings, [[f_not, [f_full]], [f_or, [f_btype, b_bunker],
                                                                          [f_btype, b_breastwork],
                                                                          [f_btype, b_armoury],
                                                                          [f_btype, b_barracks]]]);
                if empty then
                   ComEnterUnit(i, NearestUnitToUnit(empty, i));
                end;
             end;
          end;
       end;
    end;
End;

// transport siberite from Ovsyenko
Every 0$20 trigger IsOk(usCargoTransport) and not HasTask(usCargoTransport) and GetSide(ovsyenko) = 4 and GetResourceType(GetBase(ovsyenko), mat_siberit) >= 30 do
var i, path;
begin
path := [
   [67, 102],
   [90, 109],
   [112, 123],
   [126, 123]
];

for i in path do
    AddComMoveXY(usCargoTransport, i[1], i[2]);

AddComTransport(usCargoTransport, ovsyenko, mat_siberit);

path := [
   [126, 123],
   [112, 123],
   [90, 109],
   [67, 102]
];

for i in path do
    AddComMoveXY(usCargoTransport, i[1], i[2]);

if GetSide(terminal) in [1, 4] then
   begin
   AddComGive(usCargoTransport, terminal);
   AddComMoveUnit(usCargoTransport, terminal);
   AddComRefuel(usCargoTransport, terminal);
   end
else
   begin
   AddComGive(usCargoTransport, usBase);
   AddComMoveUnit(usCargoTransport, usBase);
   AddComRefuel(usCargoTransport, usBase);
   end;

AddComMoveXY(usCargoTransport, 52, 71);

enable;
End;

Every 0$02 trigger vsevolodInTerminal do
var i, un;
begin
wait(0$30);

InitHc;

for i := 1 to 3 do
    begin
    uc_side := 1;
    uc_nation := nation_american;

    PrepareSoldier(false, 3);
    un := CreateHuman;

    SetDir(un, 2);

    PlaceUnitArea(un, vsevolodSpawnArea, false);

    ComAgressiveMove(un, 63, 34);
    AddComAgressiveMove(un, 80, 40);
    end;
End;

// MAIN AI
Every 0$1 trigger not americanRetreat do
begin
BaseScript(1, americanBaseArea, cratesAmericanArea, americanBaseArea, americanBaseOuterArea,
           americanSquad, americanVehicles, americanTechs, americanConstructList, americanBuildingsToBuild,
           [52,74], [54,64], []);
enable;
End;


Every 0$1 trigger americanAttackVehicles do
var i, j, mech, enemy, area;
begin
enable;

if not americanAttackVehicles then
   exit;

// tags:
// 100 - idle,
// 101 - go to parking, repair if needed
// 102 - attack

for i in americanAttackVehicles do
    begin
    if not IsOk(i) or GetSide(i) <> 1 then
       begin
       americanAttackVehicles := americanAttackVehicles diff i;
       continue;
       end;

    if GetControl(i) = control_remote then
       begin
       if IsOk(i) and not IsControledBy(i) then
          Connect(i);
       //else if not IsOk(i) and IsControledBy(i) then
          //ComUnlink(i);
       end;

    if GetTag(i) = 300 and GetControl(i) = control_manual then
       begin
       if GetFuel(i) < 50 then
          begin
          ComMoveXY(i, 24, 36);

          repeat
           wait(0$1);
          until GetDistUnitXY(i, 24, 36) < 4;

          SetFuel(i, 100);
          end
       else if not IsInArea(i, americanParkingArea) then
          ComMoveToArea(i, americanParkingArea)
       else
          SetTag(i, 301);
       end;

    if GetTag(i) = 301 then
       begin
       if GetLives(i) < 1000 then
          begin
          if not IsDrivenBy(i) then
             continue;

          mech := IsDrivenBy(i);

          ComExitVehicle(mech);
          AddComRepairVehicle(mech, i);

          repeat
           wait(0$1);
          until GetLives(i) = 1000;

          SetLives(mech, 1000);
          ComEnterUnit(mech, i);
          end
       else if IsDrivenBy(i) then
          SetTag(i, 0);
       end;

    if GetTag(i) < 300 then
       begin
       enemy := FilterUnitsInArea(americanBaseArea, [f_enemy, 1]);

       if GetLives(i) < 650 and GetControl(i) = control_manual then
          begin
          ComStop(i);
          SetTag(i, 300);
          continue;
          end;

       if enemy then
          begin
          if not HasTask(i) then
             ComAttackUnit(i, NearestUnitToUnit(enemy, i));
          end
       else if americanAttackVehicles then
          begin
          if GetWeapon(i) = us_bulldozer then
             begin
             if not HasTask(i) then
                begin
                if GetFuel(i) < 40 then
                   begin
                   ComMoveXY(i, 73, 105);
                   AddComMoveUnit(i, usBase);
                   end
                else if not HasTask(i) and not IsAt(i, 73, 105) then
                   ComMoveXY(i, 73, 105)
                else if not HasTask(i) and not noForest then
                   begin
                   area := 0;

                   for j in [cutTree1Area, cutTree2Area, cutTree3Area, cutTree4Area] do
                       begin
                       if ListEnvironmentArea(j) then
                          begin
                          area := j;
                          CutTreeInArea(i, j);
                          break;
                          end;
                       end;

                   if not area then
                      noForest := true;
                   end;
                end;
             end
          else
             begin
             if i mod 3 = 0 then
                AgressiveMove(i, [ [87,109], [102,116], [115,123] ])
             else if i mod 3 = 1 then
                AgressiveMove(i, [ [87,109], [102,116], [108,128], [132,149], [148,155], [138,141] ])
             else if not hasClearPath then
                AgressiveMove(i, [ [78,127], [92,145], [93,152], [101,172], [136,181], [152,207] ])
             else
                AgressiveMove(i, [ [105,118], [101,85] ]);
             end;
          end;
       end;
    end;
End;

Every 0$3 trigger FilterAllUnits([[f_side, 1], [f_engine, engine_combustion]]) do
var i;
begin
enable;

for i in FilterAllUnits([[f_side, 1], [f_engine, engine_combustion]]) do
    if GetFuel(i) < 3 then
       SetFuel(i, 3);
End;

Every 0$1 trigger americanRetreat do
var i, tmp;
begin
tmp := UnitFilter(americanSquad, [f_ok]);

if not tmp then
   begin
   disable;
   exit;
   end;

for i in tmp do
    begin
    if IsInUnit(i) then
       ComExit(i)
    else
       ComMoveToArea(i, americanRetreatArea);

    if IsInArea(i, americanRetreatArea) then
       RemoveUnit(i);
    end;

enable;
End;

Every 7$00 + 5$00 trigger not americanRetreat and not americanConstructList and americanAttackVehicles < 6 do
var i, chassis, weapon, control, fac;
begin
fac := FilterAllUnits([[f_side, 1], [f_btype, b_factory], [f_ok]]);

if not fac then
   exit;

for i := 1 to [4, 5, 6, 6][Difficulty] do 
    begin
    chassis := [us_medium_tracked, us_heavy_tracked][rand(1,2)];

    if Difficulty > 2 then
       weapon := [us_heavy_gun, us_gatling_gun, us_machine_gun, us_double_gun][rand(1,4)]
    else
       weapon := [us_double_gun, us_gatling_gun, us_machine_gun][rand(1,3)];

    control := control_remote;

    if not FilterAllUnits([[f_side, 1], [f_btype, b_ext_radio]]) then
       control := control_manual;

    if weapon = us_heavy_gun and chassis <> us_heavy_tracked then
       weapon := us_double_gun;

    americanConstructList := Join(americanConstructList,
       [chassis, engine_combustion, control, weapon]
    );
    end;

if not noForest and not UnitFilter(americanAttackVehicles, [f_weapon, us_bulldozer]) then
   americanConstructList := Join(americanConstructList,
       [us_heavy_tracked, engine_combustion, control_remote, us_bulldozer]
   );

enable;
End;

Every 0$1 trigger FilterAllUnits([[f_side, 1], [f_control, control_remote], [f_ok], [f_not, [f_linked]]]) do
var i, tmp;
begin
enable;

tmp := FilterAllUnits([[f_side, 1], [f_control, control_remote], [f_ok], [f_not, [f_linked]]]);

for i in tmp do
    Connect(i);
End;

Every 0$1 trigger FilterUnitsInArea(checkPointForestArea, [f_weapon, us_bulldozer]) do
hasClearPath := true;


// build nearby mine
Export mineSquad, mineBuildings;
Every 0$1 trigger not ListEnvironmentArea(cutTree1Area) do
var i, un, cranes, tmp, tmp2, hasToBuild;
begin      
cranes := UnitFilter(americanVehicles, [[f_ok], [f_weapon, us_crane]]);

if not cranes then
   exit;

mineSquad := [];
mineBuildings := [];

for i in cranes do
    begin      
    SetTag(i, tOutside);

    ComMoveXY(i, 85, 89);
    end;

// spawn units
for i := 1 to [3, 4, 5, 6][Difficulty] do
    begin
    uc_side := 1;
    uc_nation := nation_american;

    PrepareSoldier(false, [3, 4, 5, 6][Difficulty]);
    un := CreateHuman;
    SetDir(un, 1);

    repeat
     wait(3);
    until PlaceUnitXY(un, 57, 111, false);

    Push(mineSquad, un);

    ComMoveXY(un, 79, 88);
    end;

wait(0$10);

repeat
 wait(0$1);

 mineBuildings := FilterUnitsInArea(cutTree1Area, [[f_side, 1], [f_type, unit_building]]);

 cranes := UnitFilter(americanVehicles, [[f_ok], [f_weapon, us_crane]]);
 tmp := UnitFilter(mineBuildings, [f_not, [f_lives, 1000]]);

 hasToBuild := CheckBuildingsNearbyMine();

 for i in cranes do
     begin
     if GetTag(i) <> tOutside then
        begin
        SetTag(i, tOutside);

        ComMoveXY(i, 85, 89);
        end
     else if tmp then
        ComRepairBuilding(i, tmp[1])
     else if hasToBuild then
        ComCraneBuild(i, hasToBuild[1][1], hasToBuild[1][2], hasToBuild[1][3], hasToBuild[1][4])
     else if GetDistUnitXY(i, 77, 86) > 4 then
        ComMoveXY(i, 77, 86);
     end;

 if mineBuildings then
    begin
    if mineSquad then
       begin
       tmp := UnitFilter(mineBuildings, [[f_ok], [f_empty]]);

       if tmp then
          begin           
          tmp2 := UnitFilter(mineSquad, [f_inside]);

          if tmp2 then
             begin
             for i in tmp2 do
                 if GetBType(IsInUnit(i)) = b_barracks then
                    begin
                    ComExitBuilding(i);
                    break;
                    end;
             end;
          end;

       for i in UnitFilter(mineSquad, [f_outside]) do
           begin
           if not IsOk(i) then
              begin
              mineSquad := mineSquad diff i;
              continue;
              end;

           tmp := UnitFilter(mineBuildings, [[f_ok], [f_empty]]);

           if not tmp then
              tmp := UnitFilter(mineBuildings, [[f_ok], [f_btype, b_barracks]]);

           if tmp then
              ComEnterUnit(i, tmp[1]);
           end;
        end;
    end;
until americanRetreat;
End;

Function CheckBuildingsNearbyMine();
var i, tmp, output, list;
begin
result := [];

list := [
     [[b_armoury, b_barracks], 86, 88],
     [[b_bunker], 86, 92],
     [[b_bunker], 81, 79],
     [[b_siberite_mine], 92, 86]
];

output := [
     [b_armoury, 86, 88, 4],
     [b_bunker, 86, 92, 5],
     [b_bunker, 81, 79, 4],
     [b_siberite_mine, 92, 86, 0]
];

for i := 1 to list do
    begin
    tmp := HexInfo(list[i][2], list[i][3]);

    if not tmp or not GetBType(tmp) in list[i][1] then
       Push(result, output[i]);
    end;
End;


// attack on ovsyenko
Every 0$2 trigger debugCapture or (americanAttackOvsyenko and not americanRetreat and hasOvsyenko) do
var i, un, id, eng, buildings, tmp, additionalForces, chassis, weapon, control;
begin
tmp := [];

if IsOk(Sikorski) then
   begin
   Del(americanSquad, Sikorski);
   Push(tmp, Sikorski);
   SetTag(Sikorski, 0);

   ComExitBuilding(Sikorski);
   end
else if IsOk(VanHouten) then
   begin
   Del(americanSquad, VanHouten);
   Push(tmp, VanHouten);
   SetTag(VanHouten, 0);

   ComExitBuilding(VanHouten);
   end;

if hasClearPath then
   begin
   for i := 1 to [3, 3, 4, 4][Difficulty] do
       begin
       chassis := [us_medium_tracked, us_heavy_tracked][rand(1,2)];

       if Difficulty > 2 then
          weapon := [us_heavy_gun, us_gatling_gun, us_machine_gun, us_double_gun][rand(1,4)]
       else
          weapon := [us_double_gun, us_gatling_gun, us_machine_gun][rand(1,3)];

       control := control_remote;

       if not FilterAllUnits([[f_side, 1], [f_btype, b_ext_radio]]) then
          control := control_manual;

       if weapon = us_heavy_gun and chassis <> us_heavy_tracked then
          weapon := us_double_gun;

       americanConstructList := Join(americanConstructList,
          [chassis, engine_combustion, control, weapon]
       );
       end;

   wait(2$00);
   end;

// spawn units
for i := 1 to [3, 4, 5, 6][Difficulty] do
    begin
    uc_side := 1;
    uc_nation := nation_american;

    PrepareSoldier(false, [3, 4, 5, 6][Difficulty]);
    un := CreateHuman;
    SetDir(un, 1);

    repeat
     wait(3);
    until PlaceUnitXY(un, 57, 111, false);

    Push(tmp, un);

    ComMoveXY(un, 79, 88);
    end;

uc_side := 1;
uc_nation := nation_american;

PrepareEngineer(false, [3, 4, 5, 6][Difficulty]);
un := CreateHuman;
SetDir(un, 1);

repeat
 wait(3);
until PlaceUnitXY(un, 57, 111, false);

Push(tmp, un);
eng := un;

ComMoveXY(un, 79, 88);

for i in tmp do
    begin
    ComAgressiveMove(i, 80, 87);
    AddComAgressiveMove(i, 109, 82);
    end;

wait(0$45);

for i in tmp do
    begin
    ComAgressiveMove(i, 124, 113);
    AddComAgressiveMove(i, 129, 124);
    end;

ComMoveXY(eng, 124, 112);

repeat
 wait(0$1);
until UnitsInside(ovsyenko) = 0;

ComEnterUnit(eng, ovsyenko);

repeat
 wait(0$1);
 buildings := FilterUnitsInArea(ovsyenkoBaseArea, [[f_type, unit_building], [f_side, 3]]);

 if not IsOk(eng) then
    exit;

 if not HasTask(eng) then
    for i in buildings do
        if UnitsInside(i) = 0 then
           begin
           ComCapture(eng, i);
           break;
           end;
until not buildings;

buildings := FilterUnitsInArea(ovsyenkoBaseArea, [[f_type, unit_building], [f_side, 1], [f_ok], [f_or, [f_btype, b_bunker], [f_btype, b_breastwork], [f_btype, b_armoury], [f_btype, b_barracks]]]);

for i in tmp do
    begin
    if not buildings then
       exit;

    id := rand(1, Count(buildings));
    ComEnterUnit(i, buildings[id]);

    if GetBType(buildings[id]) in [b_bunker, b_breastwork] then
       buildings := Delete(buildings, id);
    end;

if not HexInfo(136, 123) then
   ComBuild(eng, b_siberite_mine, 136, 123, 1);
End;
