On UnitDestroyed(unit) do
var side, btype;
begin
side := GetSide(unit);

if unit = Vsevolod then
   begin
   vsevolodDied := true;
   exit;
   end;

if unit = ovsyenko then
   begin
   YouLost('Ovsyenko');
   exit;
   end;

if unit = Burlak then
   begin
   YouLost('Burlak');
   exit;
   end;

if unit in ovsyenkoSquad then
   ovsyenkoSquad := ovsyenkoSquad diff unit;
End;

On UnitDestroyed_Extra(unit, killerSide, killerUnit) do
begin
if unit = Gleb and killerSide = 3 then
   begin
   DialogueOn;
   SayRadio(Platonov, 'DKillGleb-Pla-1');

   YouLost('Gleb');
   DialogueOff;
   exit;
   end;
End;

On EvacuateVehicle(driver, abandoned_vehicle, unknown1, unknown2) do
begin
if GetTag(driver) = tEscape and GetSide(driver) = 1 then
   begin
   repeat
    if IsAt(driver, 150, 71) then
       begin
       RemoveUnit(driver);
       exit;
       end;

    ComMoveXY(driver, 150, 71);
    wait(0$1);
   until not IsOk(driver);
   end;
End;

On VehicleConstructed(vehicle, factory) do
var side, driver, i;
begin
SOS_VehicleConstructed(vehicle, factory);

side := GetSide(vehicle);

End;
