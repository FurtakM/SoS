// 08.05.26
// by Serpent

Starting
begin
ResetFog;
Init;

// birds, tigers, apemans, enchidnas, horses, mastodonts, fishes
PrepareNature(6, 4, 2, 3, 0, 0, 0, natureArea, 0);
PrepareNature(0, 0, [7, 6, 5, 4][Difficulty], 0, 0, 0, 0, apeArea, 0);

PrepareRussian;
PrepareAmerican;

// Action;

if debug then
   FogOff(3);
End;

Export debug, prevMissionPrefix, currentMissionPrefix, prevMissionTime, prevMissionTech, penaltyTime, americansDefeated,
       americanSibToCollect, timeToOvsyenkoFall, hasOvsyenko, sikorskiAlive, canGoToNorth, glebWarn, noCrates, hasMatPred;
Function Init;
begin
debug := 1;

if debug then
   Difficulty := 4;

prevMissionPrefix := '05_';
currentMissionPrefix := '06_';
prevMissionTime := LoadVariable('05_Time', 47$0);
prevMissionTech := LoadVariable('05_Tech', []);
sikorskiAlive := LoadVariable('03_SikorskiAlive', debug);
americansDefeated := false;
americanSibToCollect := [500, 750, 1000, 1000][Difficulty];
timeToOvsyenkoFall := [32$00, 30$00, 28$0, 26$0][Difficulty];
hasOvsyenko := false;
penaltyTime := 0$00;
canGoToNorth := false;
glebWarn := false;
noCrates := false;
hasMatPred := false;
End;

{
 Variables:
   06_MatPred - 1
