Starting
begin
ResetFog;
Init;

// birds, tigers, apemans, enchidnas, horses, mastodonts, fishes
PrepareNature(6, 4, 2, 3, 0, 0, 0, natureArea, 0);
PrepareNature(0, 0, [7, 6, 5, 4][Difficulty], 0, 0, 0, 0, apeArea, 0);

PrepareRussian;
PrepareAmerican;

Action;

if debug then
   FogOff(3);
End;

Export debug, debugCapture, prevMissionPrefix, currentMissionPrefix, prevMissionTime, prevMissionTech, penaltyTime, americansDefeated,
       americanSibToCollect, timeToOvsyenkoFall, hasOvsyenko, sikorskiAlive, canGoToNorth, glebWarn, noCrates, hasMatPred,
       canSpawnVsevolod, seeVsevolod, vsevolodDied, vsevolodInTerminal, vsevolodCaptured, isInTrap, vsevolodTalkWithBurlak,
       stevensEscaped, stevensLeft, stevensKilled, canEnd, hasAllTechs, americanRetreat, hasClearPath, noForest, americanAttackOvsyenko;
Function Init;
begin
debug := false;
debugCapture := false;

if debug then
   Difficulty := 4;

prevMissionPrefix := '05_';
currentMissionPrefix := '06_';
prevMissionTime := LoadVariable('05_Time', 47$0);
prevMissionTech := LoadVariable('05_Tech', []);
sikorskiAlive := LoadVariable('03_SikorskiAlive', debug);
stevensEscaped := LoadVariable('05_StevensEscaped', 0);
stevensLeft := LoadVariable('05_StevensLeft', 0);
stevensKilled := LoadVariable('05_StevensKilled', 0);
americansDefeated := false;
americanSibToCollect := [1000, 750, 500, 500][Difficulty];
timeToOvsyenkoFall := [44$00, 42$00, 40$0, 38$0][Difficulty];
hasOvsyenko := false;
penaltyTime := 0$00;
canGoToNorth := false;
glebWarn := false;
noCrates := false;
hasMatPred := false;
canSpawnVsevolod := false;
seeVsevolod := false;
vsevolodDied := false;
vsevolodInTerminal := false;
vsevolodCaptured := false;
vsevolodTalkWithBurlak := false;
isInTrap := false;
hasAllTechs := false;
canEnd := false;
americanRetreat := false;
hasClearPath := false;
noForest := false;
americanAttackOvsyenko := false;
End;

