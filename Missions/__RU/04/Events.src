On UnitDestroyed(un) do
begin
SOS_UnitDestroyed(un);

if un = Burlak then
   YouLost('Burlak');

if un = Gaydar then
   YouLost('Gaydar');

if un = Popov then
   YouLost('SelfAttack');

End;  

On Contact(s1, s2) do
begin
if s1 = 3 and s2 = 6 then
   YouLost('SelfAttack');
End;

On BuildingComplete(b) do
begin
if GetBType(b) = b_depot then
   begin
   hasBase := true;
   myBase := GetBase(b);
   SetRestrict(b_depot, 3, state_disabled);
   end;
End;