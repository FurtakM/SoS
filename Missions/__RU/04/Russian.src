Export Burlak, Gnyevko, Belkov, Kirilenkova,
       Platonov, Kovalyuk, Popov, Scholtze, Kuzmov, Gaydar;
Export burlakTeam, popovTeam, ruVehicles, ruConvoyUnits, ruEngs,
       burlakSquad;
Export function PrepareRussian;
var i, b, un, tmp, techs;
begin
ruConvoyUnits := [];
ruEngs := [];
burlakSquad := [];

techs := LoadVariable(prevMissionPrefix & 'Techs', []);

if techs then
   for i := 1 to Count(techs) do
       SetTech(i, 3, techs[i]);

techs := [
   tech_gun, tech_tech1, tech_tech2, tech_tech3, tech_weap1
];

for i := 1 to Count(techs) do
    if GetTech(techs[i], 3) <> state_researched then
       SetTech(techs[i], 3, state_enabled);

uc_side := 3;
uc_nation := nation_russian;

Burlak := PrepareUnit('Burlak', (not debug), prevMissionPrefix);

uc_side := 6;

Kuzmov := NewCharacter('Kuzmov');
Platonov := NewCharacter('Platonov');
Gnyevko := PrepareUnit('Gnyevko', (not debug), prevMissionPrefix);
Kirilenkova := PrepareUnit('Kirilenkova', (not debug), prevMissionPrefix);
Kovalyuk := PrepareUnit('Kovalyuk', (not debug), prevMissionPrefix);
Belkov := PrepareUnit('Belkov', (not debug), prevMissionPrefix);
Scholtze := PrepareUnit('Scholtze', (not debug), prevMissionPrefix);
Popov := PrepareUnit('Popov', (not debug), prevMissionPrefix);

burlakTeam := CreateCharacterSet(prevMissionPrefix & 'burlakTeam');

if burlakTeam < 4 then
   for i := Count(burlakTeam) to 4 do
       begin
       PrepareHuman(false, i mod 4 + 1, 3);
       burlakTeam := Join(burlakTeam, CreateHuman);
       end;

popovTeam := CreateCharacterSet(prevMissionPrefix & 'popovTeam');

if popovTeam < 4 then
   for i := Count(popovTeam) to 4 do
       begin
       PrepareHuman(false, i mod 4 + 1, 3);
       popovTeam := Join(popovTeam, CreateHuman);
       end;

result := [Burlak, Gnyevko, Kirilenkova, Kovalyuk, Belkov, Scholtze, Popov] ^ burlakTeam ^ popovTeam;
result := result diff 0;

ruVehicles := LoadVariable(currentMissionPrefix & 'Vehicles', []);

if debug then
   ruVehicles := [ [ru_medium_wheeled, engine_combustion, control_manual, ru_heavy_machine_gun, nation_russian],
                   [ru_medium_wheeled, engine_combustion, control_manual, ru_heavy_machine_gun, nation_russian],
                   [ru_medium_wheeled, engine_combustion, control_manual, ru_heavy_machine_gun, nation_russian],
                   [ru_medium_wheeled, engine_combustion, control_manual, ru_heavy_machine_gun, nation_russian],
                   [ru_medium_wheeled, engine_combustion, control_manual, ru_heavy_machine_gun, nation_russian],
                   [ru_medium_wheeled, engine_combustion, control_manual, ru_heavy_machine_gun, nation_russian] ];

if ruVehicles > [4, 3, 2, 1][Difficulty] then
   for i := Count(ruVehicles) downto [6, 5, 4, 3][Difficulty] do
       ruVehicles := Delete(ruVehicles, i);

tmp := AreaToList(ruRoadBunkersArea, 0);

for i := 1 to tmp[1] do
    begin
    uc_side := 6;
    uc_nation := nation_russian;

    bc_type := b_breastwork;
    bc_level := 0;

    b := CreateAndPlaceBuildingXYD(tmp[1][i], tmp[2][i], 3);
    PrepareSoldier(false, 2);

    PlaceHumanInUnit(CreateHuman, b);

    PrepareEngineer(false, 3);
    un := CreateHuman;
    PlaceUnitXYR(un, 111, 56, 3, false);

    ruEngs := Join(ruEngs, un);
    end;

PlaceUnitXY(Kuzmov, 114, 119, false);
ComHold(Kuzmov);
End;

// remove each purple unit
Every 0$1 trigger FilterUnitsInArea(retreatArea, [f_side, 6]) do
var i;
begin
for i in FilterUnitsInArea(retreatArea, [f_side, 6]) do
    begin
    if i in ruConvoyUnits then
       saveCounter := Inc(saveCounter);

    RemoveUnit(i);
    end;

enable;
End;


