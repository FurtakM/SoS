// Mission 4
// 20.10.25

Starting
begin
ResetFog;

// birds, tigers, apemans, enchidnas, horses, mastodonts, fishes
PrepareNature(5, 3, 3, 5, 1, 0, 2, natureArea, waterArea);

Init;
Action;
End;

Export debug, prevMissionPrefix, currentMissionPrefix, currentMissionPopovPrefix, saveCounter, gameStart, retreatActive,
       hasBase, timeToArabAttack, convoyWave, goToUnload, askedForResources, myBase, canAskForResources, firstCargo,
       recklessAttack, belkovFreed, platonovAngerLevels, arabAttack, alreadyAsked;
Function Init;
begin
debug := 1;

if debug then
   Difficulty := 4;

prevMissionPrefix := '03_';
currentMissionPrefix := '04_';
currentMissionPopovPrefix := '04p_';
saveCounter := 0;
gameStart := false;
retreatActive := false;
hasBase := false;
timeToArabAttack := [20$0, 18$0, 16$0, 14$0];
convoyWave := 0;
myBase := 0;
goToUnload := [];
alreadyAsked := [];
askedForResources := [];
canAskForResources := false;
firstCargo := 0;
recklessAttack := LoadVariable('02_recklessAttack', 1) < 3; // 1 - asked for permission to save belkov, 2 - asked for reinforcements, 3 - no asking
belkovFreed := LoadVariable('02_belkovSaved', false); // belkov saved: true/false
platonovAngerLevels := [2, 5, 7, 8, 9];
arabAttack := false;

if not recklessAttack and not belkovFreed then
   platonovAngerLevels := [3, 6, 7, 9, 10]
else if recklessAttack and belkovFreed then
   platonovAngerLevels := [2, 4, 6, 7, 8];

//if debug then
   //FogOff(3);
End;


