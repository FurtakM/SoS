Every 0$1 do
begin
display_strings := [
   'barracks: ' & FilterUnitsInArea(a1, [f_or, [f_btype, b_armoury], [f_btype, b_barracks]]),
   'armoury: ' & FilterUnitsInArea(a2, [f_btype, b_armoury])
];
End;

Every 0$2 do
begin
AddMedal('med', 1);
AddMedal('med', 1);
AddMedal('med', 1);

GiveMedals('MAIN');
RewardPeople(FilterAllUnits([f_side, 1]));
End;