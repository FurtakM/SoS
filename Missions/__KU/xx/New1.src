Export counter;
Every 0$1 trigger FilterUnitsInArea(area08, [f_side, 1]) do
var i, tmp;
begin
counter := 0;

repeat
 wait(0$1);
 tmp := FilterUnitsInArea(area08, [f_side, 1]);

 for i in tmp do
     begin
     RemoveUnit(i);
     counter := counter + 1;
     end;
until not tmp;

display_strings := counter;
End;