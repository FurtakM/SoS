// In Trap by Serpent
// 15-10-2026
Starting
begin
ResetFog;

InitHc;
InitUc;
InitBc;

InitVariables;
InitMultiplayer;

if debug then
   begin
   Difficulty := 3;
   FogOff(1);
   end;

// birds, tigers, apemans, enchidnas, horses, mastodonts, fishes
// PrepareNature(2, 2, 0, 2, 2, 1, 4, natureArea, waterArea);
PrepareRussian(Multiplayer_SetBotSide(3));
Multiplayer_Start;

ResetFog;

game := true; // game start's now!
mp_with_score := true;

Multiplayer_End;
End;

Export debug, game, botSides;
Function InitVariables;
begin
debug := false;
// debug_strings := false;
botSides := [3];
End;

Every 0$01 trigger game and not debug_strings do
begin
enable;
display_strings := Multiplayer_DisplayStrings();
End;




