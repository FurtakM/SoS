On UnitDestroyed(un) do
var side;
begin
SOS_UnitDestroyed(un);
Multiplayer_UnitDestroyed(un);

if GetType(un) = unit_human then
   begin
   side := GetSide(un);
   nwPoints := Replace(nwPoints, side, nwPoints[side] - 100);
   SetMultiScore(side, nwPoints[side]);
   end;
End;

On UnitKamikazed(un) do
begin
SOS_UnitKamikazed(un);
End;

On BuildingComplete(b) do
Multiplayer_BuildingComplete(b);

On VehicleConstructed(vehicle, factory) do
var side;
begin
SOS_VehicleConstructed(vehicle, factory);

if GetWeapon(vehicle) in [us_siberium_rocket, ru_siberium_rocket] then
   begin
   side := GetSide(vehicle);       
   nwPoints := Replace(nwPoints, side, nwPoints[side] + 250);
   SetMultiScore(side, nwPoints[side]);

   nwBombsCounter := Replace(nwBombsCounter, side, nwBombsCounter[side] + 1);
   end;
End;

On WeaponPlaced(building, factory) do
var side;
begin
if GetBWeapon(building) in [us_siberium_rocket, ru_siberium_rocket] then
   begin
   side := GetSide(building);
   nwPoints := Replace(nwPoints, side, nwPoints[side] + 250);
   SetMultiScore(side, nwPoints[side]);

   nwBombsCounter := Replace(nwBombsCounter, side, nwBombsCounter[side] + 1);
   end;
End;

On BuildingStarted(building, builder) do
var i;
begin
for i in [blockArea1, blockArea2, blockArea3, blockArea4, blockArea5, blockArea6, blockArea7, blockArea8] do
    if IsInArea(building, i) then
       begin
       KillUnit(building);
       exit;
       end;
End;

On VehicleConstruction_ApeConsumed(factory, un) do
Multiplayer_VehicleConstruction_ApeConsumed(factory, un);

On BuildingCaptured(building, oldSide, unit) do
Multiplayer_BuildingCaptured(building, oldSide, unit);

On VehicleConstructionStarted(factory, chassis, engine, control, weapon) do
var side, progress;
begin
Multiplayer_VehicleConstructionStarted(factory, chassis, engine, control, weapon);

if weapon in [us_siberium_rocket, ru_siberium_rocket] then
   begin    
   side := GetSide(factory);

   repeat
    wait(0$1);

    if BuildingStatus(factory) = bs_idle then
       begin
       nwBombProgress := Replace(nwBombProgress, side, 0);
       exit;
       end;

    progress := GetWorkingProgress(factory);

    if progress >= nwBombProgress[side] then
       nwBombProgress := Replace(nwBombProgress, side, progress);
   until progress >= 100 or BuildingStatus(factory) = bs_idle;
   end;
End;

On VehicleCaptured(newId, oldId, oldSide, unit) do
Multiplayer_VehicleCaptured(newId, oldId, oldSide, unit);